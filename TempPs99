local N0BD
local function waitForUI(timeout)
    local t0 = tick()
    while tick() - t0 < (timeout or 10) do
        local ui = getgenv().N0BD_UI
        if ui and ui.AddTab and ui.AddToggle and ui.AddLabel then
            return ui
        end
        task.wait(0.1)
    end
    return nil
end

