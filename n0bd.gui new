            error("Dropdown options must be a non-empty table")
        end
        local selectedValue = default or options[1]
        local selectedIndex = 1
        for i, v in ipairs(options) do
            if v == selectedValue then selectedIndex = i; break end
        end

        local card = Instance.new("Frame")
        card.Name             = (title:gsub("%s+", "")) .. "DropdownCard"
        card.BackgroundColor3 = Theme.Card
        card.BorderSizePixel  = 0
        card.Size             = UDim2.new(1, 0, 0, 52)
        card.ClipsDescendants = false
        card.Parent           = page.Stack
        corner(card, CARD_RADIUS)
        stroke(card, Theme.Stroke, 0.75, 1)
        pad(card, CARD_PADDING, CARD_PADDING, CARD_PADDING, CARD_PADDING)

        local titleLabel = Instance.new("TextLabel")
        titleLabel.BackgroundTransparency = 1
        titleLabel.Size                   = UDim2.new(0.45, 0, 1, 0)
        titleLabel.Font                   = Enum.Font.GothamBold
        titleLabel.TextSize               = 13
        titleLabel.TextColor3             = Theme.Text
        titleLabel.TextXAlignment         = Enum.TextXAlignment.Left
        titleLabel.TextYAlignment         = Enum.TextYAlignment.Center
        titleLabel.TextTruncate           = Enum.TextTruncate.AtEnd
        titleLabel.Text                   = title
        titleLabel.Parent                 = card

        local valueBtn = Instance.new("TextButton")
        valueBtn.AutoButtonColor  = false
        valueBtn.BackgroundColor3 = Theme.InputBg
        valueBtn.BorderSizePixel  = 0
        valueBtn.AnchorPoint      = Vector2.new(1, 0.5)
        valueBtn.Position         = UDim2.new(1, 0, 0.5, 0)
        valueBtn.Size             = offset(150, 28)
        valueBtn.Font             = Enum.Font.GothamMedium
        valueBtn.TextSize         = 12
        valueBtn.TextColor3       = Theme.Text
        valueBtn.TextXAlignment   = Enum.TextXAlignment.Left
        valueBtn.TextYAlignment   = Enum.TextYAlignment.Center
        valueBtn.TextTruncate     = Enum.TextTruncate.AtEnd
        valueBtn.Text             = "  " .. tostring(selectedValue)
        valueBtn.Parent           = card
        corner(valueBtn, BTN_RADIUS)
        stroke(valueBtn, Theme.Stroke, 0.60, 1)
        pad(valueBtn, 0, 8, 0, 8)

        local popup
        local function closePopup()
            if popup then popup:Destroy(); popup = nil end
        end

        local function openPopup()
            if popup then closePopup() end
            local absPos = valueBtn.AbsolutePosition
            local absSize = valueBtn.AbsoluteSize
            local popupWidth = 160
            local popupHeight = math.min(#options * 30 + 6, 150)
            local x = absPos.X + absSize.X - popupWidth
            local y = absPos.Y + absSize.Y + 4

            popup = Instance.new("Frame")
            popup.Name               = "DropdownPopup"
            popup.BackgroundColor3   = Theme.Panel
            popup.BorderSizePixel    = 0
            popup.Size               = offset(popupWidth, popupHeight)
            popup.Position           = offset(x, y)
            popup.ZIndex             = 60
            popup.Parent             = gui
            corner(popup, 8)
            stroke(popup, Theme.Stroke, 0.4, 1)

            local list = Instance.new("ScrollingFrame")
            list.BackgroundTransparency = 1
            list.BorderSizePixel        = 0
            list.Size                   = UDim2.new(1, -4, 1, -4)
            list.Position              = UDim2.new(0, 2, 0, 2)
            list.CanvasSize             = UDim2.new(0, 0, 0, #options * 28)
            list.ScrollBarThickness     = 2
            list.ScrollingDirection     = Enum.ScrollingDirection.Y
            list.Parent                 = popup

            local layout = Instance.new("UIListLayout")
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Padding   = UDim.new(0, 2)
            layout.Parent    = list

            for i, opt in ipairs(options) do
                local btn = Instance.new("TextButton")
                btn.AutoButtonColor  = false
                btn.BackgroundColor3 = (i == selectedIndex) and Theme.CardActive or Theme.Card
                btn.BorderSizePixel  = 0
                btn.Size             = UDim2.new(1, 0, 0, 26)
                btn.Font             = Enum.Font.GothamMedium
                btn.TextSize         = 11
                btn.TextColor3       = (i == selectedIndex) and Theme.Accent or Theme.Text
                btn.TextXAlignment   = Enum.TextXAlignment.Left
                btn.TextYAlignment   = Enum.TextYAlignment.Center
                btn.TextTruncate     = Enum.TextTruncate.AtEnd
                btn.Text             = "  " .. tostring(opt)
                btn.Parent           = list
                corner(btn, 4)

                trackConn(btn.MouseButton1Click:Connect(function()
                    selectedValue = opt
                    selectedIndex = i
                    valueBtn.Text = "  " .. tostring(opt)
                    closePopup()
                    if callback then task.spawn(callback, opt) end
                end))
            end
        end

        trackConn(valueBtn.MouseButton1Click:Connect(function()
            if popup then closePopup() else openPopup() end
        end))

        local dropdown = {
            Get = function() return selectedValue end,
            GetIndex = function() return selectedIndex end,
            Set = function(value)
                for i, opt in ipairs(options) do
                    if opt == value then
                        selectedValue = value
                        selectedIndex = i
                        valueBtn.Text = "  " .. tostring(value)
                        if callback then task.spawn(callback, value) end
                        break
                    end
                end
            end,
            SetIndex = function(idx)
                if options[idx] then
                    selectedValue = options[idx]
                    selectedIndex = idx
                    valueBtn.Text = "  " .. tostring(selectedValue)
                    if callback then task.spawn(callback, selectedValue) end
                end
            end,
            Options = options,
            Card = card,
            Button = valueBtn,
            Title = titleLabel,
            IsVisible = function() return card.Visible end,
            SetVisible = function(v) card.Visible = v end,
        }

        register("Dropdowns", opts.Id, dropdown, opts.Aliases)
        return dropdown
    end

