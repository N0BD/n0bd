        local tw = TweenService:Create(ripple, tweenInfo, {
            Size = UDim2.fromOffset(maxDim, maxDim),
            BackgroundTransparency = 1
        })
        
        tw:Play()
        tw.Completed:Connect(function()
            ripple:Destroy()
        end)
    end


