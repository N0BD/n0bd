    local externalSetSliderValue = nil
    local isResizing = false

    trackConn(resizeGrip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isResizing = true
            scaleIndicator.Visible = true
        end
    end))

    trackConn(UserInputService.InputChanged:Connect(function(input)
        if isResizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = input.Position
            local mainPos = main.AbsolutePosition
            
            local currentDist = (Vector2.new(mousePos.X, mousePos.Y) - mainPos).Magnitude
            local baseDist = WINDOW_SIZE.Magnitude
            
            local newScale = math.clamp(currentDist / baseDist, 0.8, 1.2)
            uiScale.Scale = newScale

            local percent = math.floor(newScale * 100 + 0.5)
            scaleIndicator.Text = "Scale: " .. tostring(percent) .. "%"

            if externalSetSliderValue then
                externalSetSliderValue(percent)
            end
        end
    end))

    trackConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isResizing = false
            scaleIndicator.Visible = false
        end
    end))

