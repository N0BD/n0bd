        RunService.RenderStepped:Wait()
        main.Size = offset(WINDOW_SIZE.X - 40, WINDOW_SIZE.Y - 40)
        main.Position = offset(
            math.floor((getViewport().X - (WINDOW_SIZE.X - 40)) * 0.5),
            math.floor((getViewport().Y - (WINDOW_SIZE.Y - 40)) * 0.5)
        )
        tween(main, 0.4, {
            Size = offset(WINDOW_SIZE.X, WINDOW_SIZE.Y)
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out).Completed:Wait()
        task.defer(function() clampWindow(main, WINDOW_SIZE) end)
    end

