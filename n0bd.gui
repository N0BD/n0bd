        Text = "window hidden", Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = "SubText2",
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = miniFrame,
    })
    local miniSub = textLabel({
        Name = "MiniKey", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -92, 0.5, 0),
        Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = WHITE, BackgroundTransparency = 0.92,
        Text = TOGGLE_KEY.Name, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = "SubText",
        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = miniFrame,
    })
    corner(miniSub, 7)
    stroke(miniSub, WHITE, 0.82, 1)
    pad(miniSub, 0, 8, 0, 8)

    local _, miniRestoreBtn = gradButton(miniFrame, {
        Name = "Restore", Text = "OPEN", TextSize = 11, Radius = 15,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(70, 30),
    })
    register("Buttons", "MiniRestore", { Button = miniRestoreBtn, Click = function(cb) return trackConn(miniRestoreBtn.MouseButton1Click:Connect(cb)) end })

    local body = newT("Frame", {
        Name = "Body", Position = UDim2.fromOffset(0, TOP_H), Size = UDim2.new(1, 0, 1, -TOP_H),
        BackgroundTransparency = 1, BorderSizePixel = 0, Parent = inner,
    })

    local PROFILE_H = 60

    local sidebar = new("Frame", {
        Name = "Sidebar", Position = UDim2.fromOffset(MARGIN, MARGIN),
        Size = UDim2.new(0, SIDEBAR_W, 1, -(MARGIN * 2)), BackgroundColor3 = "Panel",
        BackgroundTransparency = 0.38, BorderSizePixel = 0, Active = true, Parent = body,
    })
    corner(sidebar, 14)
    stroke(sidebar, WHITE, 0.92, 1)

    textLabel({
        Name = "NavLabel", Position = UDim2.fromOffset(18, 14), Size = UDim2.new(1, -36, 0, 14),
        Text = "Navigation", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = "SubText2", Parent = sidebar,
    })

    local tabArea = newT("Frame", {
        Name = "TabArea", BackgroundTransparency = 1, ClipsDescendants = true,
        Position = UDim2.fromOffset(8, 36), Size = UDim2.new(1, -16, 1, -(36 + PROFILE_H + 16)), Parent = sidebar,
    })

    local tabIndicator = new("Frame", {
        Name = "TabIndicator", Size = UDim2.new(1, 0, 0, TAB_H), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, Visible = false, ZIndex = 1, Parent = tabArea,
    })
    corner(tabIndicator, 10)
    new("UIGradient", {
        Color = function(T) return ColorSequence.new(T.Accent:Lerp(WHITE, 0.14), T.Accent:Lerp(BLACK, 0.14)) end,
        Rotation = 90, Parent = tabIndicator,
    })
    stroke(tabIndicator, WHITE, 0.82, 1)

    local sidebarScroll = newT("ScrollingFrame", {
        Name = "SidebarScroll", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable, CanvasSize = UDim2.new(),
        ZIndex = 2, Parent = tabArea,
    })
    tabIndicator.Parent = sidebarScroll

    do
        local profile = new("Frame", {
            Name = "Profile", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -8),
            Size = UDim2.new(1, -16, 0, PROFILE_H), BackgroundColor3 = "Card", BackgroundTransparency = 0.3,
            BorderSizePixel = 0, Parent = sidebar,
        })
        corner(profile, 12)
        stroke(profile, WHITE, 0.92, 1)

        local avatar = new("ImageLabel", {
            Name = "Avatar", Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(36, 36),
            BackgroundColor3 = "InputBg", BorderSizePixel = 0, Image = "", Parent = profile,
        })
        corner(avatar, 999)
        stroke(avatar, "Accent", 0.4, 1.5)
        local onlineDot = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(45, 45), Size = UDim2.fromOffset(11, 11),
            BackgroundColor3 = "Success", BorderSizePixel = 0, ZIndex = 3, Parent = profile,
        })
        corner(onlineDot, 999)
        stroke(onlineDot, "Card", 0, 2)

        textLabel({
            Position = UDim2.fromOffset(60, 13), Size = UDim2.new(1, -68, 0, 16), Text = player and player.DisplayName or "Player",
            Font = Enum.Font.GothamBold, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, Parent = profile,
        })
        textLabel({
            Position = UDim2.fromOffset(60, 30), Size = UDim2.new(1, -68, 0, 14), Text = "@" .. (player and player.Name or "player"),
            Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = "SubText2", TextTruncate = Enum.TextTruncate.AtEnd, Parent = profile,
        })

        task.spawn(function()
            if not player then return end
            local ok, img = pcall(function()
                return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
            end)
            if ok and img and avatar.Parent then avatar.Image = img end
        end)
    end

    local content = new("Frame", {
        Name = "Content", Position = UDim2.fromOffset(MARGIN + SIDEBAR_W + GAP, MARGIN),
        Size = UDim2.new(1, -(MARGIN + SIDEBAR_W + GAP + MARGIN), 1, -(MARGIN * 2)),
        BackgroundColor3 = "Panel", BackgroundTransparency = 0.38, BorderSizePixel = 0, Active = true, Parent = body,
    })
    corner(content, 14)
    stroke(content, WHITE, 0.92, 1)

    local crumb, pageTitle
    do
    local contentHeader = newT("Frame", {
        Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), Parent = content,
    })
    crumb = textLabel({
        Name = "Crumb", Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -44, 0, 12),
        Text = CONFIG.TITLE .. "  >  Main", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = "SubText2", Parent = contentHeader,
    })
    pageTitle = textLabel({
        Name = "PageTitle", Position = UDim2.fromOffset(22, 26), Size = UDim2.new(1, -44, 0, 28),
        Text = "Main", Font = Enum.Font.GothamBlack, TextSize = 22, Parent = contentHeader,
    })
    accentGradient(new("Frame", {
        Position = UDim2.new(0, 22, 0, 61), Size = UDim2.new(1, -44, 0, 1),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = contentHeader,
    }), 0, NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1),
    }))

    end

    local pagesHolder = newT("Frame", {
        Name = "Pages", BackgroundTransparency = 1, ClipsDescendants = true,
        Position = UDim2.fromOffset(0, 68), Size = UDim2.new(1, 0, 1, -68), Parent = content,
    })

    local resizeGrip = newT("TextButton", {
        Name = "ResizeGrip", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        ZIndex = 50, Parent = inner,
    })
    for _, g in ipairs({ { 13, 13, 12 }, { 17, 17, 6 } }) do
        local f = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(g[1], g[2]),
            Size = UDim2.fromOffset(g[3], 2), Rotation = -45, BackgroundColor3 = "SubText2",
            BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = resizeGrip,
        })
        corner(f, 1)
    end

    local scaleIndicator = new("TextLabel", {
        Name = "ScaleIndicator", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -32),
        Size = UDim2.fromOffset(96, 26), BackgroundColor3 = "Panel2", BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = "Text", Text = "Scale 100%",
        Visible = false, ZIndex = 60, Parent = inner,
    })
    corner(scaleIndicator, 13)
    stroke(scaleIndicator, WHITE, 0.85, 1)

    local externalSetSliderValue = nil
    local isResizing = false

    trackConn(resizeGrip.InputBegan:Connect(function(input)
        if isPointerStart(input) then
            isResizing = true
            scaleIndicator.Visible = true
        end
    end))

    trackConn(UserInputService.InputChanged:Connect(function(input)
        if isResizing and isPointerMove(input) then
            local p      = screenPos(input)
            local center = main.AbsolutePosition + main.AbsoluteSize / 2
            local sx = (p.X - center.X) / (WINDOW_SIZE.X / 2)
            local sy = (p.Y - center.Y) / (WINDOW_SIZE.Y / 2)
            local total = (sx + sy) / 2
            local newUser = math.clamp(math.floor((total / autoScale()) * 100 + 0.5) / 100, 0.8, 1.2)
            userScale = newUser
            applyScale(false)
            local percent = math.floor(newUser * 100 + 0.5)
            scaleIndicator.Text = "Scale " .. tostring(percent) .. "%"
            if externalSetSliderValue then externalSetSliderValue(percent) end
        end
    end))

    trackConn(UserInputService.InputEnded:Connect(function(input)
        if isPointerStart(input) and isResizing then
            isResizing = false
            scaleIndicator.Visible = false
        end
    end))

    local themeHooks = {}

    local function addThemeHook(fn)
        table.insert(themeHooks, fn)
    end

    local function setTheme(name, animate)
        if not Presets[name] then return false end
        applyPalette(name)

        local alive = {}
        for _, e in ipairs(themeBinds) do
            if e.inst and e.inst.Parent then
                table.insert(alive, e)
                local ok, v = pcall(resolveSrc, e.src)
                if ok and v ~= nil then
                    if animate and typeof(v) == "Color3" then
                        TweenService:Create(e.inst, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { [e.prop] = v }):Play()
                    else
                        pcall(function() e.inst[e.prop] = v end)
                    end
                end
            end
        end
        themeBinds = alive

        local keep = {}
        for _, h in ipairs(themeHooks) do
            local ok, aliveFlag = pcall(h)
            if ok and aliveFlag then table.insert(keep, h) end
        end
        themeHooks = keep
        return true
    end

    local pages, tabs, tabParts = {}, {}, {}
    local tabOrderList = {}
    local selectedTab, selectToken = nil, 0
    local introDone = false

    local function tabY(index)
        return (index - 1) * (TAB_H + TAB_GAP)
    end

    local function indexOfTab(name)
        for i, n in ipairs(tabOrderList) do
            if n == name then return i end
        end
        return nil
    end

    local function relayoutTabs(animate)
        for i, name in ipairs(tabOrderList) do
            local btn = tabs[name]
            if btn then
                local pos = UDim2.fromOffset(0, tabY(i))
                if animate then tween(btn, 0.3, { Position = pos }) else btn.Position = pos end
            end
        end
        sidebarScroll.CanvasSize = UDim2.fromOffset(0, math.max(#tabOrderList * (TAB_H + TAB_GAP) - TAB_GAP, 0))
    end

    local function createPage(name)
        local group = newT("CanvasGroup", {
            Name = name, BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1), GroupTransparency = 1, Visible = false, Parent = pagesHolder,
        })
        local page = new("ScrollingFrame", {
            Name = name .. "Scroll", BackgroundTransparency = 1, BorderSizePixel = 0,
            Position = UDim2.fromOffset(16, 2), Size = UDim2.new(1, -32, 1, -8),
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 4, ScrollBarImageColor3 = "Accent", ScrollBarImageTransparency = 0.35,
            ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
            Parent = group,
        })
        local stack = newT("Frame", {
            Name = "Stack", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = page,
        })
        pad(stack, 4, 0, 16, 0)
        local list = newT("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), Parent = stack,
        })

        pages[name] = {
            Page = page, Group = group, Stack = stack, List = list,
            Slots = {}, Count = 0, Refresh = function() end,
        }
        register("Pages", name, pages[name])
        return pages[name]
    end

    local function makeSlot(page, height)
        page.Count = page.Count + 1
        return newT("Frame", {
            Name = "Slot", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, height or 0),
            AutomaticSize = height and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
            LayoutOrder = page.Count, Parent = page.Stack,
        })
    end

    local function trackSlot(page, slot, inner)
        table.insert(page.Slots, { Slot = slot, Inner = inner })
    end

    local function animatePageEntry(entry, token)
        local idx = 0
        for _, s in ipairs(entry.Slots) do
            local inner = s.Inner
            if inner and inner.Parent and s.Slot.Visible then
                idx = idx + 1
                inner.Position = UDim2.fromOffset(0, 24)
                task.delay(math.min(idx, 12) * 0.04, function()
                    if selectToken == token and inner.Parent then
                        tween(inner, 0.5, { Position = UDim2.fromOffset(0, 0) },
                            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                    end
                end)
            end
        end
    end

    local function refreshTabVisuals(instant)
        local t = instant and 0 or 0.2
        for tabName, parts in pairs(tabParts) do
            local active = (tabName == selectedTab)
            if parts.Label and parts.Label.Parent then
                tween(parts.Label, t, { TextColor3 = active and Theme.OnAccent or Theme.SubText })
                if parts.Label.Parent then
                    tween(parts.Label.Parent, t, { BackgroundTransparency = 1 })
                end
                if parts.Icon and parts.Icon.Parent then
                    tween(parts.Icon, t, { Size = active and UDim2.fromOffset(25, 25) or UDim2.fromOffset(24, 24) })
                end
            end
        end
    end

    local function moveIndicator(name, instant)
        local idx = indexOfTab(name)
        if not idx then return end
        local pos = UDim2.fromOffset(0, tabY(idx))
        if not tabIndicator.Visible then
            tabIndicator.Position = pos
            tabIndicator.Visible = true
        elseif instant then
            tabIndicator.Position = pos
        else
            tween(tabIndicator, 0.42, { Position = pos }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    end

    selectTab = function(name)
        if not pages[name] or selectedTab == name then return end
        selectedTab = name
        selectToken = selectToken + 1
        local token = selectToken
        closeAllDropdowns()

        for tabName, entry in pairs(pages) do
            if tabName == name then
                entry.Group.Visible = true
                entry.Group.GroupTransparency = 1
                tween(entry.Group, 0.32, { GroupTransparency = 0 })
                animatePageEntry(entry, token)
            elseif entry.Group.Visible then
                tween(entry.Group, 0.12, { GroupTransparency = 1 })
                task.delay(0.14, function()
                    if selectedTab ~= tabName and entry.Group.Parent then entry.Group.Visible = false end
                end)
            end
        end

        refreshTabVisuals(false)
        moveIndicator(name, false)

        pageTitle.Text = name
        crumb.Text = CONFIG.TITLE .. "  >  " .. name
        pageTitle.TextTransparency = 1
        pageTitle.Position = UDim2.fromOffset(20, 33)
        tween(pageTitle, 0.4, { TextTransparency = 0, Position = UDim2.fromOffset(20, 25) },
            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    local function createTab(name, icon)
        if pages[name] then return pages[name] end
        table.insert(tabOrderList, name)
        local index = #tabOrderList

        local tab = new("TextButton", {
            Name = name .. "Tab", AutoButtonColor = false, BackgroundColor3 = WHITE,
            BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, TAB_H),
            Position = UDim2.fromOffset(0, tabY(index)), Text = "", ZIndex = 2, Parent = sidebarScroll,
        })
        corner(tab, 10)

        local tint = TabColors[((index - 1) % #TabColors) + 1]
        local iconObj = newT("Frame", {
            Name = "Icon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
            Size = UDim2.fromOffset(24, 24), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = tab,
        })
        corner(iconObj, 7)
        newT("UIGradient", {
            Color = ColorSequence.new(tint:Lerp(WHITE, 0.25), tint:Lerp(BLACK, 0.12)), Rotation = 90, Parent = iconObj,
        })
        newT("UIStroke", {
            Color = WHITE, Transparency = 0.78, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = iconObj,
        })
        local glyph = (icon and icon ~= "" and not tostring(icon):find("[\128-\255]")) and tostring(icon) or string.upper(string.sub(name, 1, 1))
        newT("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
            TextSize = 13, TextColor3 = WHITE, Text = glyph, ZIndex = 4, Parent = iconObj,
        })

        local label = textLabel({
            Name = "Label", Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -52, 1, 0),
            Text = name, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = "SubText",
            TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = tab,
        })
        tabParts[name] = { Label = label, Icon = iconObj }

        trackConn(tab.MouseEnter:Connect(function()
            if selectedTab ~= name then
                tween(tab, 0.15, { BackgroundTransparency = 0.93 })
                tween(label, 0.15, { TextColor3 = Theme.Text })
            end
        end))
        trackConn(tab.MouseLeave:Connect(function()
            if selectedTab ~= name then
                tween(tab, 0.2, { BackgroundTransparency = 1 })
                tween(label, 0.2, { TextColor3 = Theme.SubText })
            end
        end))
        trackConn(tab.MouseButton1Click:Connect(function()
            tween(tab, 0.1, { BackgroundTransparency = 1 })
            selectTab(name)
            spawnRipple(tab, 10)
        end))

        tabs[name] = tab
        relayoutTabs(false)

        if introDone then
            tab.Position = UDim2.fromOffset(-24, tabY(index))
            tween(tab, 0.45, { Position = UDim2.fromOffset(0, tabY(index)) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end

        local page = createPage(name)
        register("Tabs", name, { Button = tab, Page = page })
        return page
    end

    local function removeTab(name)
        if name == "Main" then showToast("Cannot remove Main tab", "warning") return end
        local idx = indexOfTab(name)
        if idx then table.remove(tabOrderList, idx) end
        if tabs[name] then tabs[name]:Destroy(); tabs[name] = nil end
        tabParts[name] = nil
        unregister("Tabs", name)
        if pages[name] then
            pages[name].Group:Destroy()
            pages[name] = nil
            unregister("Pages", name)
        end
        relayoutTabs(true)
        if selectedTab == name then
            selectedTab = nil
            selectTab("Main")
        else
            moveIndicator(selectedTab, false)
        end
    end

    addThemeHook(function()
        refreshTabVisuals(true)
        return true
    end)

    local function cardBase(page, name, height)
        local slot = makeSlot(page, height)
        local card = new("Frame", {
            Name = name, BackgroundColor3 = "Card", BackgroundTransparency = 0.08, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, height), ClipsDescendants = true, Parent = slot,
        })
        corner(card, CARD_RADIUS)
        local cardStroke = stroke(card, "Stroke", 0.5, 1)
        pad(card, CARD_PADDING)

        local P = CARD_PADDING
        local fxFrame = newT("Frame", {
            Name = "CardFx", BackgroundTransparency = 1, BorderSizePixel = 0,
            Position = UDim2.fromOffset(-P, -P), Size = UDim2.new(1, 2 * P, 1, 2 * P), ZIndex = 0, Parent = card,
        })

        local hl = newT("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = fxFrame,
        })
        corner(hl, CARD_RADIUS)
        newT("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.94), NumberSequenceKeypoint.new(1, 1) }),
            Parent = hl,
        })

        local sheen = newT("Frame", {
            Name = "Sheen", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(-0.3, 0, 0.5, 0),
            Size = UDim2.new(0, 90, 2, 0), Rotation = 16, BackgroundColor3 = WHITE,
            BorderSizePixel = 0, Parent = fxFrame,
        })
        newT("UIGradient", {
            Rotation = 0,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.93), NumberSequenceKeypoint.new(1, 1),
            }),
            Parent = sheen,
        })

        local bar = new("Frame", {
            Name = "AccentBar", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(3, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = fxFrame,
        })
        corner(bar, 2)
        accentGradient(bar, 90)

        local state = { lit = false, hover = false }
        local ctl = {}

        local function refreshBar()
            local h = state.lit and 26 or (state.hover and 16 or 0)
            tween(bar, 0.3, { Size = UDim2.fromOffset(3, h) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end

        local hoverCount = 0
        function ctl.Enter()
            hoverCount = hoverCount + 1
            if hoverCount ~= 1 then return end
            state.hover = true
            tween(card, 0.18, { BackgroundColor3 = Theme.CardHover })
            tween(cardStroke, 0.18, { Color = Theme.Accent, Transparency = 0.5 })
            sheen.Position = UDim2.new(-0.3, 0, 0.5, 0)
            tween(sheen, 0.8, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            refreshBar()
        end
        function ctl.Leave()
            hoverCount = math.max(hoverCount - 1, 0)
            if hoverCount ~= 0 then return end
            state.hover = false
            tween(card, 0.22, { BackgroundColor3 = Theme.Card })
            tween(cardStroke, 0.22, { Color = Theme.Stroke, Transparency = 0.5 })
            refreshBar()
        end
        function ctl.SetLit(on)
            state.lit = on and true or false
            refreshBar()
        end
        function ctl.Hook(obj)
            trackConn(obj.MouseEnter:Connect(ctl.Enter))
            trackConn(obj.MouseLeave:Connect(ctl.Leave))
        end

        ctl.Hook(card)
        trackSlot(page, slot, card)
        return slot, card, cardStroke, ctl
    end

    local function cardTitle(card, text, widthOffset)
        return textLabel({
            Size = UDim2.new(1, -(widthOffset or 0), 0, 20), Text = text,
            Font = Enum.Font.GothamBold, TextSize = 14, Parent = card,
        })
    end

    local function cardDesc(card, text, widthOffset, y, height)
        return textLabel({
            Position = UDim2.fromOffset(0, y or 22), Size = UDim2.new(1, -(widthOffset or 0), 0, height or 28),
            Text = text, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = "SubText",
            TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = card,
        })
    end

    local function makeChevron(parent)
        local box = newT("Frame", {
            Name = "Chevron", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
            Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Parent = parent,
        })
        local function piece(cx, rot)
            local f = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, 6.5),
                Size = UDim2.fromOffset(8, 2), Rotation = rot, BackgroundColor3 = "SubText",
                BorderSizePixel = 0, Parent = box,
            })
            corner(f, 1)
        end
        piece(4.2, 45)
        piece(9.8, -45)
        return box
    end

    local function createHeader(page, text, options)
        local opts = readOptions(options, text)
        text = tostring(text or "")
        local slot = makeSlot(page, 28)
        local holder = newT("Frame", {
            Name = "Header", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = slot,
        })

        local dot = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 2), Size = UDim2.fromOffset(6, 6),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = holder,
        })
        corner(dot, 999)
        accentGradient(dot, 45)

        local tw = TextService:GetTextSize(text, 13, Enum.Font.GothamBold, Vector2.new(1000, 24)).X
        local header = textLabel({
            Position = UDim2.fromOffset(16, 2), Size = UDim2.new(0, tw + 6, 1, 0), Text = text,
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = "SubText", Parent = holder,
        })

        local lineX = 16 + tw + 14
        local line = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, lineX, 0.5, 2),
            Size = UDim2.new(1, -lineX, 0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = holder,
        })
        gradient(line, "Stroke", "Stroke", 0, NumberSequence.new(0.2, 1))

        trackSlot(page, slot, holder)
        register("Headers", opts.Id, { Label = header, Text = header, Slot = slot })
        return header
    end

    local function createDivider(page, options)
        local opts = readOptions(options, "Divider")
        local slot = makeSlot(page, 14)
        local div = new("Frame", {
            Name = "Divider", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = slot,
        })
        gradient(div, "Stroke", "Stroke", 0, NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.3),
            NumberSequenceKeypoint.new(0.85, 0.3), NumberSequenceKeypoint.new(1, 1),
        }))
        trackSlot(page, slot, div)
        register("Dividers", opts.Id, { Frame = div, Slot = slot })
        return div
    end

    local function createCard(page, name, options)
        local opts = readOptions(options, name or "Card")
        local slot = makeSlot(page, nil)
        local card = new("Frame", {
            Name = name or "Card", BackgroundColor3 = WHITE, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = slot,
        })
        corner(card, CARD_RADIUS)
        local cardStroke = stroke(card, "Stroke", 0.5, 1)
        gradient(card, "Card2", "Card", 90)
        pad(card, CARD_PADDING)
        local innerList = newT("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), Parent = card,
        })

        trackConn(card.MouseEnter:Connect(function() tween(cardStroke, 0.18, { Color = Theme.Accent, Transparency = 0.5 }) end))
        trackConn(card.MouseLeave:Connect(function() tween(cardStroke, 0.22, { Color = Theme.Stroke, Transparency = 0.5 }) end))

        trackSlot(page, slot, card)
        register("Cards", opts.Id, { Card = card, List = innerList, Slot = slot })
        return card
    end

    local function createActionCard(page, titleText, descText, buttonText, options)
        local opts = readOptions(options, titleText)
        titleText = tostring(titleText or "")
        local btnW = opts.ButtonWidth or 116

        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "Card", 78)
        local reserve = btnW + 16

        local titleLabel = cardTitle(card, titleText, reserve)
        local descLabel  = cardDesc(card, tostring(descText or ""), reserve, 22, 30)

        local holder, btn = gradButton(card, {
            Name = "ActionButton", Text = tostring(buttonText or "RUN"), TextSize = 12,
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(btnW, BTN_H + 2), Radius = BTN_RADIUS,
        })
        ctl.Hook(btn)
        local btnEnabled = true

        local action = register("Buttons", opts.Id, {
            Card = card, Button = btn, Title = titleLabel, Description = descLabel, Slot = slot,
            GetText = function() return btn.Text end,
            SetText = function(v) btn.Text = tostring(v) end,
            GetColor = function() return btn.TextColor3 end,
            SetColor = function(c) btn.TextColor3 = c end,
            SetBaseColor = function(c) setButtonBaseColor(btn, c) end,
            Click = function(cb) return trackConn(btn.MouseButton1Click:Connect(function(...) if btnEnabled then cb(...) end end)) end,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
            IsEnabled = function() return btnEnabled end,
            SetEnabled = function(on)
                btnEnabled = on ~= false
                btn.Active = btnEnabled
                tween(btn, 0.15, { TextTransparency = btnEnabled and 0 or 0.55 })
                local fill = holder:FindFirstChild("Fill") or holder
                tween(fill, 0.15, { BackgroundTransparency = btnEnabled and 0 or 0.5 })
            end,
        }, opts.Aliases)

        card:SetAttribute("N0BD_ComponentId", action.Id)
        btn:SetAttribute("N0BD_ComponentId", action.Id)
        return card, btn
    end

    local function createToggleCard(page, titleText, descText, defaultValue, callback, options)
        local opts    = readOptions(options, titleText)
        local enabled = defaultValue == true
        titleText = tostring(titleText or "")

        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "ToggleCard", 70)
        local reserve = 118

        local titleLabel = cardTitle(card, titleText, reserve)
        local descLabel  = cardDesc(card, tostring(descText or ""), reserve, 22, 30)

        local stateLabel = textLabel({
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -58, 0.5, 0), Size = UDim2.fromOffset(34, 14),
            Text = enabled and "ON" or "OFF", Font = Enum.Font.GothamBold, TextSize = 10,
            TextColor3 = enabled and "Accent" or "SubText2", TextXAlignment = Enum.TextXAlignment.Right, Parent = card,
        })

        local track = new("Frame", {
            Name = "Switch", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(48, 26), BackgroundColor3 = "ToggleOff", BorderSizePixel = 0, Parent = card,
        })
        corner(track, 999)
        stroke(track, "StrokeLight", 0.55, 1)

        local fill = new("Frame", {
            Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE,
            BackgroundTransparency = enabled and 0 or 1, BorderSizePixel = 0, Parent = track,
        })
        corner(fill, 999)
        new("UIGradient", {
            Color = function(T) return ColorSequence.new(T.Accent:Lerp(WHITE, 0.16), T.Accent:Lerp(BLACK, 0.06)) end,
            Rotation = 90, Parent = fill,
        })

        local knob = newT("Frame", {
            Name = "Knob", AnchorPoint = Vector2.new(0, 0.5),
            Position = enabled and UDim2.new(1, -25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(22, 22), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2, Parent = track,
        })
        corner(knob, 999)
        newT("UIStroke", {
            Color = BLACK, Transparency = 0.82, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = knob,
        })
        local knobDot = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(8, 8),
            BackgroundColor3 = "Accent", BackgroundTransparency = enabled and 0 or 1, BorderSizePixel = 0, Parent = knob,
        })
        corner(knobDot, 999)
        local knobScale = newT("UIScale", { Scale = 1, Parent = knob })

        local hit = newT("TextButton", {
            Name = "Toggle", AutoButtonColor = false, BackgroundTransparency = 1, Text = "", ZIndex = 8,
            Position = UDim2.fromOffset(-CARD_PADDING, -CARD_PADDING),
            Size = UDim2.new(1, CARD_PADDING * 2, 1, CARD_PADDING * 2), Parent = card,
        })
        ctl.Hook(hit)
        trackConn(hit.MouseButton1Down:Connect(function() tween(knobScale, 0.1, { Scale = 1.15 }, Enum.EasingStyle.Quad) end))
        trackConn(hit.MouseButton1Up:Connect(function() tween(knobScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end))

        local function burst()
            local ring = newT("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = track,
            })
            corner(ring, 999)
            local rs = newT("UIStroke", {
                Color = Theme.Accent, Thickness = 2, Transparency = 0.2,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring,
            })
            tween(ring, 0.5, { Size = UDim2.fromScale(1.5, 1.9) })
            tween(rs, 0.5, { Transparency = 1 })
            task.delay(0.55, function() if ring.Parent then ring:Destroy() end end)
        end

        local function applyVisual(instant, withBurst)
            local t = instant and 0 or 0.3
            tween(fill, t, { BackgroundTransparency = enabled and 0 or 1 })
            tween(knob, t, { Position = enabled and UDim2.new(1, -25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) },
                Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(knobDot, t, { BackgroundTransparency = enabled and 0 or 1 })
            stateLabel.Text = enabled and "ON" or "OFF"
            tween(stateLabel, t, { TextColor3 = enabled and Theme.Accent or Theme.SubText2 })
            ctl.SetLit(enabled)
            if enabled and withBurst then burst() end
        end

        trackConn(hit.MouseButton1Click:Connect(function()
            enabled = not enabled
            applyVisual(false, true)
            if callback then task.spawn(callback, enabled) end
        end))

        addThemeHook(function()
            applyVisual(true, false)
            return card.Parent ~= nil
        end)

        local function setState(value, fire, withBurst)
            enabled = value == true
            applyVisual(false, withBurst)
            if fire and callback then task.spawn(callback, enabled) end
        end

        local toggle = {
            Get = function() return enabled end, IsEnabled = function() return enabled end,
            SetSilent = function(value) setState(value, false, false) end,
            Set = function(value) setState(value, true, true) end,
            Enable = function() setState(true, true, true) end,
            Disable = function() setState(false, true, false) end,
            Toggle = function() setState(not enabled, true, not enabled) end,
            Button = hit, Card = card, Title = titleLabel, Description = descLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }

        task.defer(function() if card.Parent then ctl.SetLit(enabled) end end)
        register("Toggles", opts.Id, toggle, opts.Aliases)
        return toggle
    end

    local function createSliderCard(page, titleText, descText, min, max, default, callback, options)
        local opts = readOptions(options, titleText)
        min, max = min or 0, max or 100
        default = math.clamp(default or min, min, max)
        titleText = tostring(titleText or "")
        local step   = tonumber(opts.Step) or 1
        local suffix = tostring(opts.Suffix or "")

        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "SliderCard", 88)

        local titleLabel = cardTitle(card, titleText, 80)

        local valueBadge = new("TextLabel", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, -1), Size = UDim2.fromOffset(66, 22),
            BackgroundColor3 = "InputBg", BorderSizePixel = 0, Font = Enum.Font.GothamBold, TextSize = 12,
            TextColor3 = "Accent", Text = "", Parent = card,
        })
        corner(valueBadge, 11)
        stroke(valueBadge, "Accent", 0.65, 1)

        local descLabel = cardDesc(card, tostring(descText or ""), 0, 23, 16)

        local bar = new("Frame", {
            Name = "Track", Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 8),
            BackgroundColor3 = "InputBg", BorderSizePixel = 0, Parent = card,
        })
        corner(bar, 999)
        stroke(bar, "Stroke", 0.65, 1)

        local fill = new("Frame", {
            Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = bar,
        })
        corner(fill, 999)
        accentGradient(fill, 0)

        local knob = newT("Frame", {
            Name = "Knob", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(20, 20), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = bar,
        })
        corner(knob, 999)
        local knobStroke = new("UIStroke", {
            Color = "Accent", Transparency = 0.15, Thickness = 2,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = knob,
        })
        local knobScale = newT("UIScale", { Scale = 1, Parent = knob })

        local hitbox = newT("TextButton", {
            Name = "Hitbox", AutoButtonColor = false, BackgroundTransparency = 1, Text = "", ZIndex = 5,
            Position = UDim2.fromOffset(-10, 40), Size = UDim2.new(1, 20, 0, 36), Parent = card,
        })

        local currentValue, dragging = nil, false

        local function fmt(v)
            if step ~= math.floor(step) then return string.format("%.2f", v) .. suffix end
            return tostring(v) .. suffix
        end

        local function applyValue(rel, skipCallback, animate, force)
            rel = math.clamp(rel, 0, 1)
            local raw = min + (max - min) * rel
            local v = math.clamp(min + math.floor((raw - min) / step + 0.5) * step, min, max)
            if step == math.floor(step) then v = math.floor(v + 0.5) end
            local rel2 = (max > min) and (v - min) / (max - min) or 0
            local changed = v ~= currentValue
            currentValue = v
            local sz, pos = UDim2.new(rel2, 0, 1, 0), UDim2.new(rel2, 0, 0.5, 0)
            if animate then
                tween(fill, 0.25, { Size = sz })
                tween(knob, 0.25, { Position = pos })
            else
                fill.Size, knob.Position = sz, pos
            end
            valueBadge.Text = fmt(v)
            if callback and not skipCallback and (changed or force) then task.spawn(callback, v) end
        end

        local function setFromX(x)
            local width = bar.AbsoluteSize.X
            if width < 10 then return end
            applyValue((x - bar.AbsolutePosition.X) / width)
        end

        applyValue((default - min) / math.max(max - min, 1), true)

        trackConn(hitbox.InputBegan:Connect(function(input)
            if isPointerStart(input) then
                dragging = true
                tween(knobScale, 0.15, { Scale = 1.25 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                tween(knobStroke, 0.15, { Thickness = 4, Transparency = 0.5 })
                setFromX(screenPos(input).X)
            end
        end))
        trackConn(UserInputService.InputChanged:Connect(function(input)
            if dragging and isPointerMove(input) then setFromX(screenPos(input).X) end
        end))
        trackConn(UserInputService.InputEnded:Connect(function(input)
            if dragging and isPointerStart(input) then
                dragging = false
                tween(knobScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                tween(knobStroke, 0.2, { Thickness = 2, Transparency = 0.15 })
            end
        end))
        ctl.Hook(hitbox)

        if opts.Id == "UIScale" then
            externalSetSliderValue = function(val)
                applyValue((math.clamp(val, min, max) - min) / math.max(max - min, 1), true, false)
            end
        end

        local slider = {
            Get = function() return currentValue end, GetMin = function() return min end, GetMax = function() return max end,
            Set = function(v) applyValue((math.clamp(v, min, max) - min) / math.max(max - min, 1), false, true, true) end,
            Card = card, Bar = bar, Fill = fill, Knob = knob, Title = titleLabel, ValueLabel = valueBadge,
            Description = descLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }

        register("Sliders", opts.Id, slider, opts.Aliases)
        return slider
    end

    local function createLabelCard(page, titleText, valueText, options)
        local opts = readOptions(options, titleText)
        titleText = tostring(titleText or "")

        local slot, card = cardBase(page, (titleText:gsub("%s+", "")) .. "LabelCard", 46)

        local tl = textLabel({
            Size = UDim2.new(0.55, 0, 1, 0), Text = titleText, Font = Enum.Font.GothamMedium,
            TextSize = 13, TextColor3 = "SubText", Parent = card,
        })
        local vl = textLabel({
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.45, 0, 1, 0),
            Text = tostring(valueText or ""), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = "Accent2",
            TextXAlignment = Enum.TextXAlignment.Right, Parent = card,
        })
        local valueColor = nil

        local label = {
            SetValue = function(v)
                vl.Text = tostring(v)
                vl.TextColor3 = Theme.Text
                tween(vl, 0.6, { TextColor3 = valueColor or Theme.Accent2 })
            end,
            GetValue = function() return vl.Text end,
            SetTitle = function(v) tl.Text = tostring(v) end, GetTitle = function() return tl.Text end,
            SetColor = function(c) valueColor = c; vl.TextColor3 = c end,
            Title = tl, Value = vl, Card = card, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }

        register("Labels", opts.Id, label, opts.Aliases)
        return label
    end

    local function popupPlacement(anchorBtn, popupW, popupH)
        local absPos, absSize = anchorBtn.AbsolutePosition, anchorBtn.AbsoluteSize
        local vp = getViewport()
        local s  = effScale()
        local w, h = popupW * s, popupH * s
        local right = absPos.X + absSize.X
        if right - w < 8 then right = 8 + w end
        if right > vp.X - 8 then right = vp.X - 8 end
        local y, anchorY = absPos.Y + absSize.Y + 6 * s, 0
        if y + h > vp.Y - 8 then
            local above = absPos.Y - 6 * s
            if above - h >= 8 then
                y, anchorY = above, 1
            else

                y, anchorY = math.max(8, vp.Y - 8 - h), 0
            end
        end
        return right, y, anchorY
    end

    local POPUP_HEADER = 32

    local function createPopup(width, height, title, onOutside)
        local s = effScale()
        local P = { W = width, H = height, S = s }

        P.Catcher = newT("TextButton", {
            Name = "PopupCatcher", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 59, Parent = gui,
        })
        if onOutside then
            P.Catcher.MouseButton1Down:Connect(onOutside)
            P.Catcher.Activated:Connect(onOutside)
            P.Catcher.MouseButton2Click:Connect(onOutside)
        end

        P.Root = newT("Frame", {
            Name = "DropdownPopup", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromOffset(width * s, height * s), ZIndex = 60, Parent = gui,
        })
        P.Scale = newT("UIScale", { Scale = 0.92, Parent = P.Root })

        P.Shadows = {}
        for i, cfg in ipairs({ { 34, 0.90, BLACK }, { 18, 0.84, BLACK }, { 8, 0.9, Theme.Accent } }) do
            local sh = newT("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, i == 3 and 0 or 10),
                Size = UDim2.new(1, cfg[1], 1, cfg[1]), BackgroundColor3 = cfg[3], BackgroundTransparency = 1,
                BorderSizePixel = 0, ZIndex = 1, Parent = P.Root,
            })
            corner(sh, 12 * s + cfg[1] / 2)
            P.Shadows[i] = { frame = sh, target = cfg[2] }
        end

        P.Canvas = newT("CanvasGroup", {
            Name = "Canvas", BackgroundColor3 = Theme.Panel:Lerp(Theme.Accent, 0.07), BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1), GroupTransparency = 1, Active = true, ZIndex = 2, Parent = P.Root,
        })
        corner(P.Canvas, math.floor(12 * s + 0.5))
        P.Border = newT("UIStroke", {
            Color = Theme.Accent, Transparency = 0.55, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = P.Canvas,
        })

        P.Body = newT("Frame", {
            Name = "Body", BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromOffset(width, height), Parent = P.Canvas,
        })
        newT("UIScale", { Scale = s, Parent = P.Body })

        local glow = newT("Frame", {
            Size = UDim2.new(1, 0, 0, 90), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 0, Parent = P.Body,
        })
        newT("UIGradient", {
            Color = ColorSequence.new(Theme.Accent, Theme.Accent2), Rotation = 35,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1) }),
            Parent = glow,
        })

        if title and title ~= "" then
            local dot = newT("Frame", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(14, POPUP_HEADER / 2),
                Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 2, Parent = P.Body,
            })
            corner(dot, 999)
            newT("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -40, 0, POPUP_HEADER),
                Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
                Text = string.upper(tostring(title)), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, Parent = P.Body,
            })
            local line = newT("Frame", {
                Position = UDim2.fromOffset(10, POPUP_HEADER - 1), Size = UDim2.new(1, -20, 0, 1),
                BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.78, BorderSizePixel = 0, ZIndex = 2, Parent = P.Body,
            })
        end

        function P.SetSize(w, h)
            P.W, P.H = w, h
            P.Root.Size = UDim2.fromOffset(w * s, h * s)
            P.Body.Size = UDim2.fromOffset(w, h)
        end
        function P.Place(x, y, anchorY)
            P.Root.AnchorPoint = Vector2.new(1, anchorY)
            P.Root.Position = UDim2.fromOffset(x, y)
        end
        function P.Alive() return P.Root.Parent ~= nil end
        function P.Show()
            tween(P.Scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(P.Canvas, 0.18, { GroupTransparency = 0 })
            for _, e in ipairs(P.Shadows) do tween(e.frame, 0.25, { BackgroundTransparency = e.target }) end
        end
        function P.Destroy()
            if P.Dead then return end
            P.Dead = true
            if P.Catcher then P.Catcher:Destroy() end
            tween(P.Scale, 0.14, { Scale = 0.95 })
            tween(P.Canvas, 0.14, { GroupTransparency = 1 })
            for _, e in ipairs(P.Shadows) do tween(e.frame, 0.12, { BackgroundTransparency = 1 }) end
            task.delay(0.16, function() if P.Root.Parent then P.Root:Destroy() end end)
        end
        return P
    end

    local function makeRow(parent, text, isSelected, order, rowH, multi)
        local selected = isSelected and true or false
        local hovered  = false
        local row = newT("TextButton", {
            AutoButtonColor = false, BackgroundColor3 = Theme.Accent, BackgroundTransparency = selected and 0.86 or 1,
            BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, rowH), Font = Enum.Font.GothamMedium, TextSize = 13,
            TextColor3 = selected and Theme.Text or Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(text), LayoutOrder = order, Parent = parent,
        })
        corner(row, 9)
        local rowPad = pad(row, 0, 38, 0, 16)

        local bar = newT("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -12, 0.5, 0), Size = UDim2.fromOffset(3, 14),
            BackgroundColor3 = Theme.Accent, BackgroundTransparency = selected and 0 or 1, BorderSizePixel = 0, Parent = row,
        })
        corner(bar, 2)

        local mark = newT("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 30, 0.5, 0), Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = Theme.Accent, BackgroundTransparency = selected and 0 or 1, BorderSizePixel = 0, Parent = row,
        })
        corner(mark, multi and 5 or 999)
        local markStroke = newT("UIStroke", {
            Color = Theme.Accent, Thickness = 1.5, Transparency = (multi and not selected) and 0.35 or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = mark,
        })
        local tick = drawCheck(mark, Theme.OnAccent, 11, selected and 0 or 1)

        local function refresh(t)
            t = t or 0.12
            tween(row, t, { BackgroundTransparency = selected and (hovered and 0.74 or 0.86) or (hovered and 0.88 or 1) })
            tween(row, t, { TextColor3 = (selected or hovered) and Theme.Text or Theme.SubText })
            tween(bar, t, { BackgroundTransparency = (selected or hovered) and 0 or 1,
                            Size = UDim2.fromOffset(3, (selected and 16) or (hovered and 10 or 14)) })
            tween(rowPad, t, { PaddingLeft = UDim.new(0, hovered and 20 or 16) })
            tween(mark, t, { BackgroundTransparency = selected and 0 or 1 })
            tween(markStroke, t, { Transparency = (multi and not selected) and 0.35 or 1 })
            fadeCheck(tick, t, selected and 0 or 1)
        end
        refresh(0)
        row.Font = selected and Enum.Font.GothamBold or Enum.Font.GothamMedium

        row.MouseEnter:Connect(function() hovered = true; refresh(0.08) end)
        row.MouseLeave:Connect(function() hovered = false; refresh(0.14) end)

        local api = {}
        function api.SetSelected(v)
            selected = v and true or false
            row.Font = selected and Enum.Font.GothamBold or Enum.Font.GothamMedium
            refresh(0.12)
        end
        function api.IsSelected() return selected end
        return row, api
    end

    local function makeListScroll(P, y, h)
        local list = newT("ScrollingFrame", {
            BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, h),
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 2,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, ScrollBarImageTransparency = 0.35, Parent = P.Body,
        })
        pad(list, 4, 10, 8, 10)
        newT("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3), Parent = list })
        return list
    end

    local function createDropdownCard(page, title, options, default, callback, opts)
        opts = readOptions(opts, title)
        if type(options) ~= "table" or #options == 0 then error("Dropdown options must be a non-empty table") end
        title = tostring(title or "")
        local selectedValue, selectedIndex = default or options[1], 1
        for i, v in ipairs(options) do if v == selectedValue then selectedIndex = i; break end end

        local slot, card, _, ctl = cardBase(page, (title:gsub("%s+", "")) .. "DropdownCard", 60)

        local titleLabel = textLabel({
            Size = UDim2.new(0.45, 0, 1, 0), Text = title, Font = Enum.Font.GothamBold, TextSize = 14, Parent = card,
        })

        local valueBtn = new("TextButton", {
            Name = "Value", AutoButtonColor = false, BackgroundColor3 = "InputBg", BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(172, 32),
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = "Text", TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(selectedValue), Parent = card,
        })
        corner(valueBtn, BTN_RADIUS)
        local valueStroke = stroke(valueBtn, "Stroke", 0.45, 1)
        pad(valueBtn, 0, 30, 0, 12)
        local chevron = makeChevron(valueBtn)
        ctl.Hook(valueBtn)

        trackConn(valueBtn.MouseEnter:Connect(function() tween(valueBtn, 0.12, { BackgroundColor3 = Theme.InputBgHover }) end))
        trackConn(valueBtn.MouseLeave:Connect(function() tween(valueBtn, 0.18, { BackgroundColor3 = Theme.InputBg }) end))

        local POPUP_W, ROW_H, MAX_ROWS = 220, 34, 6
        local popup, conns, closePopup

        closePopup = function()
            unregisterPopup(closePopup)
            for _, c in ipairs(conns or {}) do pcall(function() c:Disconnect() end) end
            conns = nil
            if popup then
                local p = popup
                popup = nil
                p.Destroy()
            end
            tween(chevron, 0.2, { Rotation = 0 })
            tween(valueStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.45 })
        end

        local function openPopup()
            closeAllDropdowns(closePopup)
            if popup then return end

            local count  = math.min(#options, MAX_ROWS)
            local listH  = count * (ROW_H + 3) + 12
            local popupH = POPUP_HEADER + listH
            local px, py, anchorY = popupPlacement(valueBtn, POPUP_W, popupH)

            popup = createPopup(POPUP_W, popupH, title, function() closePopup() end)
            popup.Place(px, py, anchorY)
            local list = makeListScroll(popup, POPUP_HEADER, listH)

            conns = {}
            for i, opt in ipairs(options) do
                local row = makeRow(list, opt, i == selectedIndex, i, ROW_H)
                local function pick()
                    if not popup then return end
                    selectedValue, selectedIndex = opt, i
                    valueBtn.Text = tostring(opt)
                    closePopup()
                    if callback then task.spawn(callback, opt) end
                end
                table.insert(conns, row.MouseButton1Click:Connect(pick))
                table.insert(conns, row.Activated:Connect(pick))
            end
            if selectedIndex > 3 then
                task.defer(function()
                    if list.Parent then list.CanvasPosition = Vector2.new(0, (selectedIndex - 2) * (ROW_H + 3)) end
                end)
            end

            popup.Show()
            tween(chevron, 0.25, { Rotation = 180 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(valueStroke, 0.2, { Color = Theme.Accent, Transparency = 0.2 })
            registerPopup(closePopup)

            table.insert(conns, RunService.RenderStepped:Connect(function()
                if not popup or not popup.Alive() or not valueBtn.Parent or not main.Visible then
                    closePopup() return
                end
                local center = valueBtn.AbsolutePosition + valueBtn.AbsoluteSize / 2
                if not isInside(center, page.Page) then closePopup() return end
                popup.Place(popupPlacement(valueBtn, POPUP_W, popupH))
            end))
        end

        trackConn(valueBtn.MouseButton1Click:Connect(function()
            if popup then closePopup() else openPopup() end
        end))

        local dropdown
        dropdown = {
            Get = function() return selectedValue end, GetIndex = function() return selectedIndex end,
            Set = function(value)
                for i, opt in ipairs(options) do
                    if opt == value then
                        selectedValue, selectedIndex = value, i
                        valueBtn.Text = tostring(value)
                        if callback then task.spawn(callback, value) end
                        break
                    end
                end
            end,
            SetSilent = function(value)
                for i, opt in ipairs(options) do
                    if opt == value then selectedValue, selectedIndex = value, i; valueBtn.Text = tostring(value); break end
                end
            end,
            SetIndex = function(idx)
                if options[idx] then
                    selectedValue, selectedIndex = options[idx], idx
                    valueBtn.Text = tostring(selectedValue)
                    if callback then task.spawn(callback, selectedValue) end
                end
            end,
            SetOptions = function(newOptions, keepSelection)
                if type(newOptions) ~= "table" or #newOptions == 0 then return false end
                if popup then closePopup() end
                local copy = {}
                for i, v in ipairs(newOptions) do copy[i] = v end
                options = copy
                dropdown.Options = copy
                local found
                for i, v in ipairs(copy) do if v == selectedValue then found = i; break end end
                if found and keepSelection ~= false then
                    selectedIndex = found
                else
                    selectedValue, selectedIndex = copy[1], 1
                    valueBtn.Text = tostring(copy[1])
                end
                return true
            end,
            GetOptions = function() local c = {} for i, v in ipairs(options) do c[i] = v end return c end,
            Close = closePopup, Options = options, Card = card, Button = valueBtn, Title = titleLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }

        register("Dropdowns", opts.Id, dropdown, opts.Aliases)
        return dropdown
    end

    local function createTextInputCard(page, title, placeholder, buttonText, callback, opts)
        opts = readOptions(opts, title)
        title = tostring(title or "")
        local currentValue = ""

        local slot = makeSlot(page, nil)
        local card = new("Frame", {
            Name = (title:gsub("%s+", "")) .. "TextInputCard", BackgroundColor3 = WHITE, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = slot,
        })
        corner(card, CARD_RADIUS)
        local cardStroke = stroke(card, "Stroke", 0.5, 1)
        gradient(card, "Card2", "Card", 90)
        pad(card, CARD_PADDING)
        newT("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), Parent = card })

        local titleLabel = textLabel({
            Size = UDim2.new(1, 0, 0, 18), Text = title, Font = Enum.Font.GothamBold, TextSize = 14,
            LayoutOrder = 1, Parent = card,
        })

        local container = new("Frame", {
            BackgroundColor3 = "InputBg", BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 40),
            LayoutOrder = 2, Parent = card,
        })
        corner(container, 10)
        local containerStroke = stroke(container, "Stroke", 0.45, 1)

        local box = new("TextBox", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -108, 1, 0), Font = Enum.Font.Gotham, TextSize = 13,
            TextColor3 = "Text", PlaceholderColor3 = "SubText2", TextXAlignment = Enum.TextXAlignment.Left,
            PlaceholderText = placeholder or "Enter text...", Text = "", ClearTextOnFocus = false,
            ClipsDescendants = true, Parent = container,
        })
        pad(box, 0, 0, 0, 14)

        local _, btn = gradButton(container, {
            Name = "SendButton", Text = tostring(buttonText or "Send"), TextSize = 11, Radius = 7,
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(88, 28),
        })

        trackConn(box.Focused:Connect(function()
            tween(containerStroke, 0.18, { Color = Theme.Accent, Transparency = 0.1 })
            tween(container, 0.18, { BackgroundColor3 = Theme.InputBgHover })
        end))
        trackConn(box.FocusLost:Connect(function()
            tween(containerStroke, 0.22, { Color = Theme.Stroke, Transparency = 0.45 })
            tween(container, 0.22, { BackgroundColor3 = Theme.InputBg })
        end))
        trackConn(card.MouseEnter:Connect(function() tween(cardStroke, 0.18, { Color = Theme.Accent, Transparency = 0.5 }) end))
        trackConn(card.MouseLeave:Connect(function() tween(cardStroke, 0.22, { Color = Theme.Stroke, Transparency = 0.5 }) end))

        local function submit()
            local val = box.Text
            if val == "" then val = placeholder or "" end
            currentValue = val
            if callback then task.spawn(callback, val) end
        end

        trackConn(btn.MouseButton1Click:Connect(submit))
        trackConn(box.FocusLost:Connect(function(enterPressed) if enterPressed then submit() end end))

        local input = {
            Get = function() return currentValue end,
            Set = function(v)
                currentValue = tostring(v or ""); box.Text = currentValue
                if callback then task.spawn(callback, currentValue) end
            end,
            Button = btn, TextBox = box, Container = container, Card = card, Title = titleLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }

        trackSlot(page, slot, card)
        register("Inputs", opts.Id, input, opts.Aliases)
        return input
    end

    local function createSearchListCard(page, title, items, callback, options)
        local opts = readOptions(options, title)
        title = tostring(title or "")
        local itemsArr, itemsLower = {}, {}
        for i, v in ipairs(items or {}) do itemsArr[i] = v; itemsLower[i] = string.lower(tostring(v)) end
        local rowConns = {}
        local MAX_ROWS = math.max(10, tonumber(opts.MaxRows) or 60)

        local slot, card, _, ctl = cardBase(page, (title:gsub("%s+", "")) .. "SearchListCard", 60)

        local titleLabel = textLabel({
            Size = UDim2.new(0.45, 0, 1, 0), Text = title, Font = Enum.Font.GothamBold, TextSize = 14, Parent = card,
        })

        local valueBtn = new("TextButton", {
            Name = "Value", AutoButtonColor = false, BackgroundColor3 = "InputBg", BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(172, 32),
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = "SubText", TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Text = "Select...", Parent = card,
        })
        corner(valueBtn, BTN_RADIUS)
        local valueStroke = stroke(valueBtn, "Stroke", 0.45, 1)
        pad(valueBtn, 0, 30, 0, 12)
        local chevron = makeChevron(valueBtn)
        ctl.Hook(valueBtn)

        trackConn(valueBtn.MouseEnter:Connect(function() tween(valueBtn, 0.12, { BackgroundColor3 = Theme.InputBgHover }) end))
        trackConn(valueBtn.MouseLeave:Connect(function() tween(valueBtn, 0.18, { BackgroundColor3 = Theme.InputBg }) end))

        local selectedValue, pendingSearch = nil, ""
        local popup, conns, closePopup
        local searchBox, listScroll, emptyLabel
        local rows = {}

        local POPUP_W, ROW_H, MAX_LIST_H = 236, 32, 210
        local SEARCH_Y, LIST_Y = POPUP_HEADER + 4, POPUP_HEADER + 46

        local function setSelected(item)
            selectedValue = item
            valueBtn.Text = tostring(item)
            valueBtn.TextColor3 = Theme.Text
        end

        closePopup = function()
            unregisterPopup(closePopup)
            for _, c in ipairs(conns or {}) do pcall(function() c:Disconnect() end) end
            for _, c in ipairs(rowConns) do pcall(function() c:Disconnect() end) end
            conns, rowConns = nil, {}
            if searchBox then pendingSearch = searchBox.Text end
            if popup then
                local p = popup
                popup = nil
                p.Destroy()
            end
            searchBox, listScroll, emptyLabel, rows = nil, nil, nil, {}
            tween(chevron, 0.2, { Rotation = 0 })
            tween(valueStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.45 })
        end

        local function currentHeight()
            local visible = 0
            for _, r in ipairs(rows) do if r.btn.Visible then visible = visible + 1 end end
            local listH = math.clamp(visible * (ROW_H + 3) + 12, 52, MAX_LIST_H)
            return listH, LIST_Y + listH
        end

        local function applyFilter()
            if not searchBox or not listScroll then return end
            local q = string.lower(tostring(searchBox.Text or ""))
            for _, c in ipairs(rowConns) do pcall(function() c:Disconnect() end) end
            rowConns = {}
            for _, r in ipairs(rows) do r.btn:Destroy() end
            rows = {}
            local shown = 0
            for i, item in ipairs(itemsArr) do
                if q == "" or string.find(itemsLower[i], q, 1, true) then
                    shown = shown + 1
                    if shown > MAX_ROWS then break end
                    local row = makeRow(listScroll, item, item == selectedValue, shown, ROW_H)
                    rows[shown] = { item = item, btn = row }
                    local function pick()
                        if not popup then return end
                        setSelected(item)
                        closePopup()
                        if callback then task.spawn(callback, item) end
                    end
                    table.insert(rowConns, row.MouseButton1Click:Connect(pick))
                    table.insert(rowConns, row.Activated:Connect(pick))
                end
            end
            local listH, totalH = currentHeight()
            if listScroll then listScroll.Size = UDim2.new(1, 0, 0, listH) end
            if popup then popup.SetSize(POPUP_W, totalH) end
            if emptyLabel then
                local any = false
                for _, r in ipairs(rows) do if r.btn.Visible then any = true; break end end
                emptyLabel.Visible = not any
            end
        end

        local function openPopup()
            closeAllDropdowns(closePopup)
            if popup then return end

            local totalH = LIST_Y + math.clamp(#itemsArr * (ROW_H + 3) + 12, 52, MAX_LIST_H)
            local px, py, anchorY = popupPlacement(valueBtn, POPUP_W, totalH)

            popup = createPopup(POPUP_W, totalH, title, function() closePopup() end)
            popup.Place(px, py, anchorY)

            local sc = newT("Frame", {
                BackgroundColor3 = Theme.InputBg, BorderSizePixel = 0, ZIndex = 2,
                Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, SEARCH_Y), Parent = popup.Body,
            })
            corner(sc, 10)
            local scStroke = newT("UIStroke", {
                Color = Theme.Stroke, Transparency = 0.4, Thickness = 1,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = sc,
            })

            local mag = newT("Frame", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 11, 0.5, 0), Size = UDim2.fromOffset(16, 16),
                BackgroundTransparency = 1, ZIndex = 3, Parent = sc,
            })
            local ring = newT("Frame", {
                Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = mag,
            })
            corner(ring, 999)
            newT("UIStroke", { Color = Theme.SubText2, Thickness = 1.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring })
            local handle = newT("Frame", {
                Position = UDim2.fromOffset(9, 12), Size = UDim2.fromOffset(6, 2), Rotation = 45,
                BackgroundColor3 = Theme.SubText2, BorderSizePixel = 0, ZIndex = 3, Parent = mag,
            })
            corner(handle, 1)

            searchBox = newT("TextBox", {
                BackgroundTransparency = 1, Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(34, 0), ZIndex = 3,
                Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.Text, PlaceholderColor3 = Theme.SubText2,
                PlaceholderText = "Search...", Text = pendingSearch or "", ClearTextOnFocus = false,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = sc,
            })

            listScroll = makeListScroll(popup, LIST_Y, MAX_LIST_H)

            emptyLabel = newT("TextLabel", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(0, LIST_Y + 14), Size = UDim2.new(1, 0, 0, 24), ZIndex = 3,
                Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Theme.SubText2, Text = "No results",
                Visible = false, Parent = popup.Body,
            })

            conns = {}
            rows = {}

            table.insert(conns, searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter))
            table.insert(conns, searchBox.Focused:Connect(function() tween(scStroke, 0.15, { Color = Theme.Accent, Transparency = 0.1 }) end))
            table.insert(conns, searchBox.FocusLost:Connect(function() tween(scStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.4 }) end))
            applyFilter()

            popup.Show()
            tween(chevron, 0.25, { Rotation = 180 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(valueStroke, 0.2, { Color = Theme.Accent, Transparency = 0.2 })
            registerPopup(closePopup)

            table.insert(conns, RunService.RenderStepped:Connect(function()
                if not popup or not popup.Alive() or not valueBtn.Parent or not main.Visible then
                    closePopup() return
                end
                local center = valueBtn.AbsolutePosition + valueBtn.AbsoluteSize / 2
                if not isInside(center, page.Page) then closePopup() return end
                popup.Place(popupPlacement(valueBtn, POPUP_W, popup.H))
            end))
        end

        trackConn(valueBtn.MouseButton1Click:Connect(function()
            if popup then closePopup() else openPopup() end
        end))

        local function hasItem(v)
            for _, it in ipairs(itemsArr) do if it == v then return true end end
            return false
        end

        local list = {
            Get = function() return selectedValue end,
            Select = function(v)
                if hasItem(v) then setSelected(v); if popup then closePopup() end end
            end,
            Clear = function()
                selectedValue = nil
                valueBtn.Text = "Select..."
                valueBtn.TextColor3 = Theme.SubText
            end,
            Close = closePopup,
            SetItems = function(newItems)
                itemsArr, itemsLower = {}, {}
                for i, v in ipairs(newItems or {}) do itemsArr[i] = v; itemsLower[i] = string.lower(tostring(v)) end
                if popup then closePopup() end
                if selectedValue ~= nil and not hasItem(selectedValue) then
                    selectedValue = nil
                    valueBtn.Text = "Select..."
                    valueBtn.TextColor3 = Theme.SubText
                end
            end,
            GetItems = function()
                local arr = {}
                for i, v in ipairs(itemsArr) do arr[i] = v end
                return arr
            end,
            SetSearchText = function(text)
                pendingSearch = tostring(text or "")
                if searchBox then searchBox.Text = pendingSearch end
            end,
            GetSearchText = function() return searchBox and searchBox.Text or pendingSearch end,
            Card = card, Button = valueBtn, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }

        register("Lists", opts.Id, list, opts.Aliases)
        return list
    end

    local Ext = {}
    do

    do
        local byId, anyList = {}, {}

        local function addTo(list, fn)
            local entry = { fn = fn }
            table.insert(list, entry)
            local conn = { Connected = true }
            function conn:Disconnect()
                self.Connected = false
                for i, e in ipairs(list) do
                    if e == entry then table.remove(list, i) break end
                end
            end
            conn.disconnect = conn.Disconnect
            return conn
        end

        local function run(list, ...)
            local snapshot = {}
            for i, e in ipairs(list) do snapshot[i] = e end
            for _, e in ipairs(snapshot) do
                local ok, err = pcall(e.fn, ...)
                if not ok then warn("[n0bd.hub] listener error: " .. tostring(err)) end
            end
        end

        function Ext.OnChanged(id, fn)
            id = componentId(id)
            byId[id] = byId[id] or {}
            return addTo(byId[id], fn)
        end
        function Ext.OnAnyChanged(fn) return addTo(anyList, fn) end
        function Ext.emit(id, ...)
            id = componentId(id)
            if byId[id] then run(byId[id], ...) end
            run(anyList, id, ...)
            if Ext.onChanged then Ext.onChanged(id) end
        end

        local function wrapCb(fn, cbIdx, optIdx, titleIdx)
            return function(...)
                local args = table.pack(...)
                local id = readOptions(args[optIdx], args[titleIdx]).Id
                local orig = args[cbIdx]
                args[cbIdx] = function(...)
                    if orig then
                        local ok, err = pcall(orig, ...)
                        if not ok then warn("[n0bd.hub] callback error (" .. id .. "): " .. tostring(err)) end
                    end
                    Ext.emit(id, ...)
                end
                return fn(table.unpack(args, 1, math.max(args.n, cbIdx)))
            end
        end
        createToggleCard     = wrapCb(createToggleCard, 5, 6, 2)
        createSliderCard     = wrapCb(createSliderCard, 7, 8, 2)
        createDropdownCard   = wrapCb(createDropdownCard, 5, 6, 2)
        createTextInputCard  = wrapCb(createTextInputCard, 5, 6, 2)
        createSearchListCard = wrapCb(createSearchListCard, 4, 5, 2)
    end

    local SAVE_KINDS = {
        Toggles = true, Sliders = true, Dropdowns = true, Inputs = true, Lists = true,
        Keybinds = true, ColorPickers = true, Segments = true, MultiDropdowns = true,
    }

    function Ext.GetValue(id)
        local o = getRegistered(nil, id)
        if not o then return nil end
        local getter = o.Get or o.GetValue
        if not getter then return nil end
        local ok, v = pcall(getter)
        if ok then return v end
        return nil
    end

    function Ext.SetValue(id, value, silent)
        local o = getRegistered(nil, id)
        if not o then return false end
        local setter
        if silent and o.SetSilent then setter = o.SetSilent else setter = o.Set or o.Select or o.SetValue end
        if not setter then return false end
        return (pcall(setter, value))
    end

    function Ext.Click(id)
        local o = getRegistered("Buttons", id)
        if not o or not o.Button then return false end
        o.Button.MouseButton1Click:Fire()
        return true
    end

    local function expand(s)
        s = tostring(s)
        s = s:gsub("{PlaceId}", function() return tostring(game.PlaceId) end)
        s = s:gsub("{GameId}", function() return tostring(game.GameId) end)
        s = s:gsub("{Player}", function() return player and player.Name or "player" end)
        s = s:gsub("{UserId}", function() return player and tostring(player.UserId) or "0" end)
        return s
    end
    local function cleanName(v, fallback)
        v = expand(v):gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
        if v == "" then return fallback end
        return v
    end
    local function cleanFolder(v, fallback)
        v = expand(v):gsub("\\", "/"):gsub("[^%w_%-%. /]", ""):gsub("%.%.+", "."):gsub("//+", "/")
        v = v:gsub("^[%./%s]+", ""):gsub("[/%s]+$", "")
        if v == "" then return fallback end
        return v
    end

    local CONFIG_DIR = cleanFolder(opt("ConfigFolder", "n0bd.hub"), "n0bd.hub")
    Ext.ConfigName = cleanName(opt("ConfigName", "default"), "default")
    local S = { uiToken = 0, scriptDirty = false, uiDirty = false, hooks = {} }
    S.uiDir  = cleanFolder(opt("UiFolder", "n0bd.hub/Gui Settings"), "n0bd.hub/Gui Settings")
    S.uiFile = cleanName(opt("UiFileName", "Settings"), "Settings")
    Ext.UiEnabled  = opt("UiSettings", true) ~= false
    Ext.UiReady    = false
    Ext.BaseDone   = false
    Ext.AutoSave   = opt("AutoSave", false) == true
    Ext.Loading    = false
    Ext.Ready      = false
    Ext.Loaded, Ext.LoadedKey = nil, nil

    function Ext.SetConfigName(name)
        Ext.ConfigName = cleanName(name, Ext.ConfigName)
        local input = getRegistered("Inputs", "ConfigName")
        if input then input.TextBox.Text = Ext.ConfigName end
        return Ext.ConfigName
    end
    function Ext.GetConfigName() return Ext.ConfigName end
    function Ext.SetConfigFolder(name)
        CONFIG_DIR = cleanFolder(name, CONFIG_DIR)
        return CONFIG_DIR
    end
    function Ext.GetConfigFolder() return CONFIG_DIR end

    local function scopeOf(o) return o.Scope or "ui" end

    function Ext.ExportConfig(scope)
        local out, seen = {}, {}
        for id, o in pairs(Components.All) do
            if SAVE_KINDS[o.Type] and not o.NoSave and not seen[o] and (not scope or scopeOf(o) == scope) then
                seen[o] = true
                local getter = o.GetSave or o.Get
                if getter then
                    local ok, v = pcall(getter)
                    if ok and v ~= nil then out[o.Id or id] = v end
                end
            end
        end
        return out
    end

    function Ext.ImportConfig(values, scope)
        local applied = 0
        if type(values) ~= "table" then return 0 end
        local was = Ext.Loading
        Ext.Loading = true
        for id, v in pairs(values) do
            local o = getRegistered(nil, id)
            if o and SAVE_KINDS[o.Type] and not o.NoSave and (not scope or scopeOf(o) == scope) then
                local setter = o.SetSave or o.Set or o.Select
                if setter and pcall(setter, v) then applied = applied + 1 end
            end
        end
        Ext.Loading = was
        return applied
    end

    function Ext.GetConfigJSON(values)
        return HttpService:JSONEncode({ Format = "n0bd.hub", Version = 1, Values = values or Ext.ExportConfig() })
    end

    function Ext.LoadConfigJSON(json)
        local ok, data = pcall(function() return HttpService:JSONDecode(tostring(json)) end)
        if not ok or type(data) ~= "table" then return 0, "invalid JSON" end
        return Ext.ImportConfig(data.Values or data)
    end

    local function cfgName(name) return cleanName(name or Ext.ConfigName, "default") end
    local function cfgPath(name) return CONFIG_DIR .. "/" .. cfgName(name) .. ".json" end
    function S.uiPath() return S.uiDir .. "/" .. S.uiFile .. ".json" end

    local function ensureFolder(dir)
        if type(makefolder) ~= "function" or type(isfolder) ~= "function" then return end
        local path = ""
        for part in (dir or CONFIG_DIR):gmatch("[^/]+") do
            path = (path == "") and part or (path .. "/" .. part)
            if not isfolder(path) then pcall(makefolder, path) end
        end
    end

    function S.readValuesAt(path)
        if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil, "readfile not available" end
        if not isfile(path) then return nil, "config not found" end
        local ok, content = pcall(readfile, path)
        if not ok then return nil, tostring(content) end
        local okJ, data = pcall(function() return HttpService:JSONDecode(tostring(content)) end)
        if not okJ or type(data) ~= "table" then return nil, "invalid JSON" end
        return data.Values or data, path
    end
    local function readValues(name) return S.readValuesAt(cfgPath(name)) end

    function Ext.SaveConfig(name)
        if type(writefile) ~= "function" then return false, "writefile not available" end
        ensureFolder(CONFIG_DIR)
        local path = cfgPath(name)
        local values = Ext.ExportConfig("script")
        if Ext.Loaded and Ext.LoadedKey == path then
            for k, v in pairs(Ext.Loaded) do
                if values[k] == nil then
                    local o = getRegistered(nil, k)
                    if not o or scopeOf(o) == "script" then values[k] = v end
                end
            end
        end
        local ok, err = pcall(writefile, path, Ext.GetConfigJSON(values))
        if not ok then return false, tostring(err) end
        Ext.Loaded, Ext.LoadedKey = values, path
        return true, path
    end

    function Ext.LoadConfig(name)
        local values, path = readValues(name)
        if not values then return false, path end
        Ext.Loaded, Ext.LoadedKey = values, path
        return true, Ext.ImportConfig(values, "script")
    end

    function Ext.SaveUi()
        if type(writefile) ~= "function" then return false, "writefile not available" end
        ensureFolder(S.uiDir)
        local ok, err = pcall(writefile, S.uiPath(), Ext.GetConfigJSON(Ext.ExportConfig("ui")))
        if not ok then return false, tostring(err) end
        return true, S.uiPath()
    end

    function Ext.LoadUi()
        local values, path = S.readValuesAt(S.uiPath())
        if not values then return false, path end
        return true, Ext.ImportConfig(values, "ui")
    end

    function Ext.GetUiFolder() return S.uiDir end

    function Ext.GetSettingsPath(scope)
        if tostring(scope):lower():find("^script") then return cfgPath() end
        return S.uiPath()
    end

    function Ext.ListConfigs()
        local names = {}
        if type(listfiles) == "function" and type(isfolder) == "function" and isfolder(CONFIG_DIR) then
            local ok, files = pcall(listfiles, CONFIG_DIR)
            if ok and type(files) == "table" then
                for _, f in ipairs(files) do
                    local rel = tostring(f):gsub("\\", "/")
                    if rel:sub(1, #CONFIG_DIR + 1) == CONFIG_DIR .. "/" then rel = rel:sub(#CONFIG_DIR + 2) end
                    local n = rel:match("^([^/]+)%.json$")
                    if n then table.insert(names, n) end
                end
            end
        end
        table.sort(names)
        return names
    end

    function S.removeFile(path)
        if type(delfile) ~= "function" or type(isfile) ~= "function" or not isfile(path) then return false end
        return (pcall(delfile, path))
    end

    function Ext.DeleteConfig(name)
        return S.removeFile(cfgPath(name))
    end

    local lastRegister = os.clock()
    registerHook = function(kind, id, object)
        lastRegister = os.clock()
        if type(object) == "table" and object.Scope == nil then object.Scope = Ext.BaseDone and "script" or "ui" end
        if not (Ext.Loaded and SAVE_KINDS[kind]) then return end
        local stored = Ext.Loaded[id]
        if stored == nil then return end
        task.defer(function()
            if object.NoSave then return end
            local setter = object.SetSave or object.Set or object.Select
            if not setter then return end
            local was = Ext.Loading
            Ext.Loading = true
            pcall(setter, stored)
            Ext.Loading = was
        end)
    end

    local readyCbs, saveToken = {}, 0

    function Ext.SetAutoSave(on) Ext.AutoSave = on and true or false end
    function Ext.GetAutoSave() return Ext.AutoSave end

    function Ext.FlushSave()
        saveToken = saveToken + 1
        S.uiToken = S.uiToken + 1
        local saved = false
        if S.uiDirty and Ext.UiEnabled and Ext.UiReady then S.uiDirty = false; saved = Ext.SaveUi() end
        if S.scriptDirty and Ext.Ready and Ext.AutoSave then S.scriptDirty = false; saved = Ext.SaveConfig() or saved end
        return saved
    end

    function Ext.onChanged(id)
        if Ext.Loading then return end
        local o = id and getRegistered(nil, id)
        if o and o.NoSave then return end
        local delay = math.max(0.2, tonumber(opt("AutoSaveDelay", 1)) or 1)
        if o and scopeOf(o) == "ui" then
            if not (Ext.UiEnabled and Ext.UiReady) then return end
            S.uiDirty = true
            S.uiToken = S.uiToken + 1
            local mine = S.uiToken
            task.delay(delay, function()
                if mine == S.uiToken and S.uiDirty then S.uiDirty = false; Ext.SaveUi() end
            end)
            return
        end
        if not (Ext.AutoSave and Ext.Ready) then return end
        S.scriptDirty = true
        saveToken = saveToken + 1
        local mine = saveToken
        task.delay(delay, function()
            if mine == saveToken and S.scriptDirty and Ext.AutoSave and Ext.Ready then S.scriptDirty = false; Ext.SaveConfig() end
        end)
    end

    function Ext.OnDeleteScriptSettings(fn)
        if type(fn) == "function" then table.insert(S.hooks, fn) end
    end

    function Ext.DeleteSettings(scope)
        scope = tostring(scope or ""):lower()
        local removed = 0
        if scope:find("^ui") or scope:find("^gui") then
            S.uiToken, S.uiDirty = S.uiToken + 1, false
            if S.removeFile(S.uiPath()) then removed = 1 end
        elseif scope:find("^script") then
            saveToken, S.scriptDirty = saveToken + 1, false
            if S.removeFile(cfgPath()) then removed = 1 end
            Ext.Loaded, Ext.LoadedKey = nil, nil
            for _, fn in ipairs({ table.unpack(S.hooks) }) do
                local ok, res = pcall(fn)
                if ok then
                    if type(res) == "number" then removed = removed + res elseif res == true then removed = removed + 1 end
                end
            end
        else
            return false, 0
        end
        return removed > 0, removed
    end

    function Ext.FinishLoad()
        if Ext.Ready then return false end
        if opt("AutoLoad", false) == true then
            local ok, res = Ext.LoadConfig()
            if ok and opt("ShowLoadedToast", true) then showToast("Config loaded: " .. Ext.ConfigName, "success", 2.2) end
        elseif Ext.AutoSave then
            Ext.Loaded, Ext.LoadedKey = readValues(), cfgPath()
            if not Ext.Loaded then Ext.LoadedKey = nil end
        end
        Ext.Ready = true
        for _, fn in ipairs(readyCbs) do task.spawn(fn) end
        readyCbs = {}
        return true
    end

    function Ext.OnReady(fn)
        if Ext.Ready then task.spawn(fn) else table.insert(readyCbs, fn) end
    end

    task.spawn(function()
        local started = os.clock()
        while not Ext.Ready do
            task.wait(0.2)
            local now = os.clock()
            if now - started > 20 then break end
            if now - started > 1.2 and now - lastRegister > 0.9 then break end
        end
        Ext.FinishLoad()
    end)

    local function hsv2c(h, s, v)
        h = (h % 1) * 6
        local i = math.floor(h)
        local f = h - i
        local p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
        local r, g, b
        if i == 0 then r, g, b = v, t, p
        elseif i == 1 then r, g, b = q, v, p
        elseif i == 2 then r, g, b = p, v, t
        elseif i == 3 then r, g, b = p, q, v
        elseif i == 4 then r, g, b = t, p, v
        else r, g, b = v, p, q end
        return Color3.new(r, g, b)
    end

    local function c2hsv(c)
        local r, g, b = c.R, c.G, c.B
        local mx, mn = math.max(r, g, b), math.min(r, g, b)
        local d = mx - mn
        local h = 0
        if d > 0 then
            if mx == r then h = ((g - b) / d) % 6
            elseif mx == g then h = (b - r) / d + 2
            else h = (r - g) / d + 4 end
            h = h / 6
        end
        return h, mx == 0 and 0 or d / mx, mx
    end

    local function c2hex(c)
        return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end

    local function hex2c(str)
        str = tostring(str or ""):gsub("^#", ""):gsub("%s", "")
        if #str == 3 then str = str:sub(1, 1):rep(2) .. str:sub(2, 2):rep(2) .. str:sub(3, 3):rep(2) end
        if #str ~= 6 or not str:match("^%x+$") then return nil end
        local n = tonumber(str, 16)
        return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
    end

    local function copyList(t) local c = {} for i, v in ipairs(t or {}) do c[i] = v end return c end

    local function parseKey(v)
        if v == nil or v == false or v == "" or v == "None" then return nil end
        local n
        if type(v) == "string" then n = v else
            local ok, name = pcall(function() return v.Name end)
            if ok then n = name end
        end
        if type(n) ~= "string" then return nil end
        if n:find("^MouseButton") then
            if not pcall(function() return Enum.UserInputType[n] end) then return nil end
            return { kind = "Mouse", name = n }
        end
        local ok, item = pcall(function() return Enum.KeyCode[n] end)
        if not ok or item == nil then return nil end
        return { kind = "Key", name = n }
    end

    local function keyLabel(k)
        if not k then return "None" end
        if k.kind == "Mouse" then
            return ({ MouseButton1 = "Mouse 1", MouseButton2 = "Mouse 2", MouseButton3 = "Mouse 3" })[k.name] or k.name
        end
        return k.name
    end

    local function keyEnum(k)
        if not k then return nil end
        if k.kind == "Mouse" then return Enum.UserInputType[k.name] end
        return Enum.KeyCode[k.name]
    end

    function Ext.AddKeybind(page, titleText, descText, default, callback, options)
        local opts = readOptions(options, titleText)
        titleText = tostring(titleText or "")
        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "KeybindCard", 70)
        local reserve = 144

        local titleLabel = cardTitle(card, titleText, reserve)
        local descLabel  = cardDesc(card, tostring(descText or ""), reserve, 22, 30)

        local cur = parseKey(default)
        local mode = opts.Mode or "Press"
        local listening, listenConn, listenToken = false, nil, 0
        local down, active = false, false
        local pressCbs, releaseCbs = {}, {}

        local keyBtn = new("TextButton", {
            Name = "KeyButton", AutoButtonColor = false, BackgroundColor3 = "InputBg", BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(128, 32),
            Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = "Accent", Text = keyLabel(cur), Parent = card,
        })
        corner(keyBtn, BTN_RADIUS)
        local keyStroke = stroke(keyBtn, "Stroke", 0.45, 1)
        ctl.Hook(keyBtn)

        trackConn(keyBtn.MouseEnter:Connect(function()
            if not listening then tween(keyBtn, 0.12, { BackgroundColor3 = Theme.InputBgHover }) end
        end))
        trackConn(keyBtn.MouseLeave:Connect(function() tween(keyBtn, 0.18, { BackgroundColor3 = Theme.InputBg }) end))

        local function refreshText()
            keyBtn.Text = listening and "Press a key..." or keyLabel(cur)
            keyBtn.TextColor3 = listening and Theme.SubText or (cur and Theme.Accent or Theme.SubText2)
        end

        local obj
        local function stopListening()
            listening = false
            listenToken = listenToken + 1
            if listenConn then listenConn:Disconnect() listenConn = nil end
            tween(keyStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.45 })
            refreshText()
        end

        local function setKey(newKey, fire)
            cur = newKey
            down, active = false, false
            if listening then stopListening() else refreshText() end
            if fire then
                if callback then task.spawn(callback, keyEnum(cur), cur and cur.name or nil) end
                Ext.emit(opts.Id, cur and cur.name or nil)
            end
        end

        local function startListening()
            if listening then return stopListening() end
            listening = true
            listenToken = listenToken + 1
            local mine = listenToken
            refreshText()
            tween(keyStroke, 0.2, { Color = Theme.Accent, Transparency = 0.1 })
            listenConn = UserInputService.InputBegan:Connect(function(input)
                local t = input.UserInputType and input.UserInputType.Name
                if t == "Keyboard" then
                    local n = input.KeyCode and input.KeyCode.Name
                    if n == "Escape" then stopListening()
                    elseif n == "Backspace" or n == "Delete" then setKey(nil, true)
                    elseif n and n ~= "Unknown" then setKey({ kind = "Key", name = n }, true) end
                elseif t == "MouseButton2" or t == "MouseButton3" then
                    setKey({ kind = "Mouse", name = t }, true)
                elseif t == "MouseButton1" then
                    stopListening()
                end
            end)
            task.delay(8, function() if listening and listenToken == mine then stopListening() end end)
        end
        trackConn(keyBtn.MouseButton1Click:Connect(startListening))

        local function matches(input)
            if not cur or not input.UserInputType then return false end
            if cur.kind == "Key" then
                return input.UserInputType.Name == "Keyboard" and input.KeyCode and input.KeyCode.Name == cur.name
            end
            return input.UserInputType.Name == cur.name
        end

        local function firePress()
            down = true
            if mode == "Toggle" then active = not active else active = true end
            for _, fn in ipairs(copyList(pressCbs)) do task.spawn(fn, active) end
        end
        local function fireRelease()
            down = false
            if mode == "Hold" then active = false end
            for _, fn in ipairs(copyList(releaseCbs)) do task.spawn(fn, active) end
        end

        trackConn(UserInputService.InputBegan:Connect(function(input, processed)
            if listening or processed or not matches(input) then return end
            firePress()
        end))
        trackConn(UserInputService.InputEnded:Connect(function(input)
            if down and matches(input) then fireRelease() end
        end))

        local function listAdd(list, fn)
            table.insert(list, fn)
            local conn = { Connected = true }
            function conn:Disconnect()
                self.Connected = false
                for i, f in ipairs(list) do if f == fn then table.remove(list, i) break end end
            end
            return conn
        end

        refreshText()
        addThemeHook(function() refreshText() return card.Parent ~= nil end)

        obj = {
            Get = function() return keyEnum(cur) end,
            GetName = function() return cur and cur.name or nil end,
            Set = function(v) setKey(parseKey(v), true) end,
            SetSilent = function(v) setKey(parseKey(v), false) end,
            Clear = function() setKey(nil, true) end,
            GetSave = function() return cur and cur.name or false end,
            SetSave = function(v) setKey(parseKey(v), true) end,
            OnPress = function(fn) return listAdd(pressCbs, fn) end,
            OnRelease = function(fn) return listAdd(releaseCbs, fn) end,
            Press = function() firePress() if mode ~= "Toggle" then fireRelease() end end,
            IsDown = function() return down end,
            GetState = function() return active end,
            SetState = function(b) active = b and true or false end,
            SetMode = function(m) if m == "Press" or m == "Toggle" or m == "Hold" then mode = m; active = false end end,
            GetMode = function() return mode end,
            IsListening = function() return listening end,
            Button = keyBtn, Card = card, Title = titleLabel, Description = descLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }
        if opts.OnPress then obj.OnPress(opts.OnPress) end
        register("Keybinds", opts.Id, obj, opts.Aliases)
        return obj
    end

    function Ext.AddSegmented(page, titleText, descText, items, default, callback, options)
        local opts = readOptions(options, titleText)
        if type(items) ~= "table" or #items == 0 then error("Segmented options must be a non-empty table") end
        titleText = tostring(titleText or "")
        local n = #items
        local segW = 0
        for _, it in ipairs(items) do
            segW = math.max(segW, TextService:GetTextSize(tostring(it), 12, Enum.Font.GothamBold, Vector2.new(400, 20)).X + 26)
        end
        segW = math.clamp(math.floor(segW), 56, 120)
        if n * segW > 300 then segW = math.floor(300 / n) end
        local totalW = n * segW + 6

        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "SegmentedCard", 70)
        local reserve = totalW + 18
        local titleLabel = cardTitle(card, titleText, reserve)
        local descLabel  = cardDesc(card, tostring(descText or ""), reserve, 22, 30)

        local selIndex = 1
        for i, v in ipairs(items) do if v == default then selIndex = i break end end

        local pill = new("Frame", {
            Name = "Segments", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(totalW, 32), BackgroundColor3 = "InputBg", BorderSizePixel = 0, Parent = card,
        })
        corner(pill, 10)
        stroke(pill, "Stroke", 0.45, 1)
        ctl.Hook(pill)

        local indicator = new("Frame", {
            Name = "Indicator", Position = UDim2.fromOffset(3 + (selIndex - 1) * segW, 3), Size = UDim2.fromOffset(segW, 26),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1, Parent = pill,
        })
        corner(indicator, 8)
        accentGradient(indicator, 90)

        local buttons = {}
        for i, it in ipairs(items) do
            local b = newT("TextButton", {
                Name = "Seg" .. i, AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
                Position = UDim2.fromOffset(3 + (i - 1) * segW, 3), Size = UDim2.fromOffset(segW, 26), ZIndex = 2,
                Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.SubText, Text = tostring(it),
                TextTruncate = Enum.TextTruncate.AtEnd, Parent = pill,
            })
            buttons[i] = b
        end

        local function refresh(instant)
            local t = instant and 0 or 0.28
            tween(indicator, t, { Position = UDim2.fromOffset(3 + (selIndex - 1) * segW, 3) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            for i, b in ipairs(buttons) do
                tween(b, instant and 0 or 0.2, { TextColor3 = (i == selIndex) and Theme.OnAccent or Theme.SubText })
            end
        end
        refresh(true)
        addThemeHook(function() refresh(true) return card.Parent ~= nil end)

        local function select(i, fire)
            if not items[i] then return false end
            local changed = i ~= selIndex
            selIndex = i
            refresh(false)
            if fire and callback then task.spawn(callback, items[i], i) end
            if fire then Ext.emit(opts.Id, items[i], i) end
            return changed
        end
        for i, b in ipairs(buttons) do
            trackConn(b.MouseButton1Click:Connect(function() select(i, true) end))
            trackConn(b.MouseEnter:Connect(function() if i ~= selIndex then tween(b, 0.1, { TextColor3 = Theme.Text }) end end))
            trackConn(b.MouseLeave:Connect(function() if i ~= selIndex then tween(b, 0.15, { TextColor3 = Theme.SubText }) end end))
        end

        local function indexOf(v)
            for i, it in ipairs(items) do if it == v then return i end end
            if type(v) == "number" and items[v] then return v end
        end

        local obj = {
            Get = function() return items[selIndex] end, GetIndex = function() return selIndex end,
            Set = function(v) local i = indexOf(v) if i then select(i, true) end end,
            SetSilent = function(v) local i = indexOf(v) if i then select(i, false) end end,
            SetIndex = function(i) select(i, true) end,
            Options = items, Buttons = buttons, Card = card, Title = titleLabel, Description = descLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }
        register("Segments", opts.Id, obj, opts.Aliases)
        return obj
    end

    function Ext.AddMultiDropdown(page, titleText, items, defaults, callback, options)
        local opts = readOptions(options, titleText)
        if type(items) ~= "table" or #items == 0 then error("MultiDropdown options must be a non-empty table") end
        titleText = tostring(titleText or "")
        local maxCount = tonumber(opts.Max)

        local selected = {}
        for _, v in ipairs(defaults or {}) do selected[v] = true end

        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "MultiDropdownCard", 60)
        local titleLabel = textLabel({
            Size = UDim2.new(0.45, 0, 1, 0), Text = titleText, Font = Enum.Font.GothamBold, TextSize = 14, Parent = card,
        })
        local valueBtn = new("TextButton", {
            Name = "Value", AutoButtonColor = false, BackgroundColor3 = "InputBg", BorderSizePixel = 0,
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(172, 32),
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = "Text", TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = card,
        })
        corner(valueBtn, BTN_RADIUS)
        local valueStroke = stroke(valueBtn, "Stroke", 0.45, 1)
        pad(valueBtn, 0, 30, 0, 12)
        local chevron = makeChevron(valueBtn)
        ctl.Hook(valueBtn)
        trackConn(valueBtn.MouseEnter:Connect(function() tween(valueBtn, 0.12, { BackgroundColor3 = Theme.InputBgHover }) end))
        trackConn(valueBtn.MouseLeave:Connect(function() tween(valueBtn, 0.18, { BackgroundColor3 = Theme.InputBg }) end))

        local function list()
            local out = {}
            for _, v in ipairs(items) do if selected[v] then table.insert(out, v) end end
            return out
        end
        local function refreshText()
            local l = list()
            if #l == 0 then valueBtn.Text = "None"; valueBtn.TextColor3 = Theme.SubText2
            elseif #l <= 2 then valueBtn.Text = table.concat(l, ", "); valueBtn.TextColor3 = Theme.Text
            else valueBtn.Text = #l .. " selected"; valueBtn.TextColor3 = Theme.Text end
        end
        refreshText()

        local POPUP_W, ROW_H, MAX_ROWS = 220, 34, 6
        local popup, conns, closePopup
        local rowApis = {}
        local obj

        local function change(value, state, silent)
            if state and maxCount and #list() >= maxCount and not selected[value] then return false end
            selected[value] = state and true or nil
            if rowApis[value] then rowApis[value].SetSelected(state) end
            refreshText()
            if not silent then
                local l = list()
                if callback then task.spawn(callback, l, value, state and true or false) end
                Ext.emit(opts.Id, l, value, state and true or false)
            end
            return true
        end

        closePopup = function()
            unregisterPopup(closePopup)
            for _, c in ipairs(conns or {}) do pcall(function() c:Disconnect() end) end
            conns = nil
            rowApis = {}
            if popup then local p = popup; popup = nil; p.Destroy() end
            tween(chevron, 0.2, { Rotation = 0 })
            tween(valueStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.45 })
        end

        local function openPopup()
            closeAllDropdowns(closePopup)
            if popup then return end
            local count  = math.min(#items, MAX_ROWS)
            local listH  = count * (ROW_H + 3) + 12
            local popupH = POPUP_HEADER + listH
            local px, py, anchorY = popupPlacement(valueBtn, POPUP_W, popupH)
            popup = createPopup(POPUP_W, popupH, titleText, function() closePopup() end)
            popup.Place(px, py, anchorY)

            conns = {}
            local function headerBtn(text, x)
                local b = newT("TextButton", {
                    AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4,
                    Position = UDim2.new(1, x, 0, 6), Size = UDim2.fromOffset(34, 20), Font = Enum.Font.GothamBold,
                    TextSize = 11, TextColor3 = Theme.Accent, Text = text, Parent = popup.Body,
                })
                return b
            end
            local allBtn, noneBtn = headerBtn("All", -80), headerBtn("None", -44)
            table.insert(conns, allBtn.MouseButton1Click:Connect(function() obj.SelectAll() end))
            table.insert(conns, noneBtn.MouseButton1Click:Connect(function() obj.Clear() end))

            local listFrame = makeListScroll(popup, POPUP_HEADER, listH)
            for i, opt in ipairs(items) do
                local row, api = makeRow(listFrame, opt, selected[opt], i, ROW_H, true)
                rowApis[opt] = api
                table.insert(conns, row.MouseButton1Click:Connect(function()
                    if popup then change(opt, not selected[opt], false) end
                end))
            end

            popup.Show()
            tween(chevron, 0.25, { Rotation = 180 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(valueStroke, 0.2, { Color = Theme.Accent, Transparency = 0.2 })
            registerPopup(closePopup)

            table.insert(conns, RunService.RenderStepped:Connect(function()
                if not popup or not popup.Alive() or not valueBtn.Parent or not main.Visible then closePopup() return end
                local center = valueBtn.AbsolutePosition + valueBtn.AbsoluteSize / 2
                if not isInside(center, page.Page) then closePopup() return end
                popup.Place(popupPlacement(valueBtn, POPUP_W, popupH))
            end))
        end
        trackConn(valueBtn.MouseButton1Click:Connect(function()
            if popup then closePopup() else openPopup() end
        end))

        local function setAll(arr, silent)
            local want = {}
            for _, v in ipairs(arr or {}) do want[v] = true end
            for _, v in ipairs(items) do
                local state = want[v] and true or false
                if (selected[v] and true or false) ~= state then change(v, state, true) end
            end
            if not silent then
                local l = list()
                if callback then task.spawn(callback, l, nil, nil) end
                Ext.emit(opts.Id, l)
            end
        end

        obj = {
            Get = list,
            GetMap = function() local m = {} for k in pairs(selected) do m[k] = true end return m end,
            IsSelected = function(v) return selected[v] == true end,
            Set = function(arr) setAll(arr, false) end,
            SetSilent = function(arr) setAll(arr, true) end,
            SetOption = function(v, state) return change(v, state and true or false, false) end,
            Toggle = function(v) return change(v, not selected[v], false) end,
            SelectAll = function() setAll(items, false) end,
            Clear = function() setAll({}, false) end,
            SetOptions = function(newItems)
                if type(newItems) ~= "table" or #newItems == 0 then return false end
                if popup then closePopup() end
                items = copyList(newItems)
                obj.Options = items
                local keep = {}
                for _, v in ipairs(items) do if selected[v] then keep[v] = true end end
                selected = keep
                refreshText()
                return true
            end,
            Close = closePopup, Options = items, Card = card, Button = valueBtn, Title = titleLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }
        register("MultiDropdowns", opts.Id, obj, opts.Aliases)
        return obj
    end

    function Ext.AddColorPicker(page, titleText, descText, default, callback, options)
        local opts = readOptions(options, titleText)
        titleText = tostring(titleText or "")
        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "ColorCard", 70)
        local reserve = 140
        local titleLabel = cardTitle(card, titleText, reserve)
        local descLabel  = cardDesc(card, tostring(descText or ""), reserve, 22, 30)

        local H, S, V = c2hsv(typeof(default) == "Color3" and default or Theme.Accent)
        local current = hsv2c(H, S, V)

        local swatchBtn = new("TextButton", {
            Name = "Swatch", AutoButtonColor = false, BackgroundColor3 = "InputBg", BorderSizePixel = 0, Text = "",
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(124, 32), Parent = card,
        })
        corner(swatchBtn, BTN_RADIUS)
        local swStroke = stroke(swatchBtn, "Stroke", 0.45, 1)
        ctl.Hook(swatchBtn)
        local chip = newT("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.fromOffset(34, 20),
            BackgroundColor3 = current, BorderSizePixel = 0, Parent = swatchBtn,
        })
        corner(chip, 6)
        newT("UIStroke", { Color = WHITE, Transparency = 0.7, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = chip })
        local hexLabel = textLabel({
            Position = UDim2.fromOffset(48, 0), Size = UDim2.new(1, -52, 1, 0), Text = c2hex(current),
            Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = "SubText", Parent = swatchBtn,
        })

        local popup, conns, closePopup
        local dragging = nil
        local svBase, svCursor, hueCursor, hexBox, previewChip

        local function applyColor(fire, fromHex)
            current = hsv2c(H, S, V)
            chip.BackgroundColor3 = current
            hexLabel.Text = c2hex(current)
            if popup then
                if svBase then svBase.BackgroundColor3 = hsv2c(H, 1, 1) end
                if svCursor then svCursor.Position = UDim2.new(S, 0, 1 - V, 0) end
                if hueCursor then hueCursor.Position = UDim2.new(H, 0, 0.5, 0) end
                if hexBox and not fromHex then hexBox.Text = c2hex(current) end
                if previewChip then previewChip.BackgroundColor3 = current end
            end
            if fire then
                if callback then task.spawn(callback, current) end
                Ext.emit(opts.Id, current)
            end
        end

        closePopup = function()
            unregisterPopup(closePopup)
            for _, c in ipairs(conns or {}) do pcall(function() c:Disconnect() end) end
            conns = nil
            dragging = nil
            svBase, svCursor, hueCursor, hexBox, previewChip = nil, nil, nil, nil, nil
            if popup then local p = popup; popup = nil; p.Destroy() end
            tween(swStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.45 })
        end

        local PRESETS = {
            rgb(255, 69, 58), rgb(255, 159, 10), rgb(255, 214, 10), rgb(48, 209, 88),
            rgb(64, 200, 224), rgb(10, 132, 255), rgb(191, 90, 242), rgb(255, 255, 255),
        }

        local function openPopup()
            closeAllDropdowns(closePopup)
            if popup then return end
            local POPUP_W, POPUP_H = 234, 306
            local px, py, anchorY = popupPlacement(swatchBtn, POPUP_W, POPUP_H)
            popup = createPopup(POPUP_W, POPUP_H, titleText, function() closePopup() end)
            popup.Place(px, py, anchorY)
            local body = popup.Body
            conns = {}

            svBase = newT("Frame", {
                Name = "SV", Position = UDim2.fromOffset(15, 44), Size = UDim2.fromOffset(204, 124),
                BackgroundColor3 = hsv2c(H, 1, 1), BorderSizePixel = 0, ZIndex = 2, Parent = body,
            })
            corner(svBase, 9)
            local white = newT("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = svBase,
            })
            corner(white, 9)
            newT("UIGradient", {
                Rotation = 0, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
                Parent = white,
            })
            local black = newT("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 4, Parent = svBase,
            })
            corner(black, 9)
            newT("UIGradient", {
                Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
                Parent = black,
            })
            svCursor = newT("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(S, 0, 1 - V, 0), Size = UDim2.fromOffset(14, 14),
                BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6, Parent = svBase,
            })
            corner(svCursor, 999)
            newT("UIStroke", { Color = WHITE, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = svCursor })
            local svHit = newT("TextButton", {
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), ZIndex = 7, Parent = svBase,
            })

            local hueBar = newT("Frame", {
                Name = "Hue", Position = UDim2.fromOffset(15, 178), Size = UDim2.fromOffset(204, 14),
                BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2, Parent = body,
            })
            corner(hueBar, 7)
            local stops = {}
            for i = 0, 6 do stops[#stops + 1] = ColorSequenceKeypoint.new(i / 6, hsv2c(i / 6, 1, 1)) end
            newT("UIGradient", { Color = ColorSequence.new(stops), Parent = hueBar })
            hueCursor = newT("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(H, 0, 0.5, 0), Size = UDim2.fromOffset(8, 20),
                BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 4, Parent = hueBar,
            })
            corner(hueCursor, 4)
            newT("UIStroke", { Color = BLACK, Transparency = 0.6, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = hueCursor })
            local hueHit = newT("TextButton", {
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(-4, -6),
                Size = UDim2.new(1, 8, 1, 12), ZIndex = 5, Parent = hueBar,
            })

            previewChip = newT("Frame", {
                Position = UDim2.fromOffset(15, 204), Size = UDim2.fromOffset(34, 32), BackgroundColor3 = current,
                BorderSizePixel = 0, ZIndex = 2, Parent = body,
            })
            corner(previewChip, 9)
            local boxHolder = newT("Frame", {
                Position = UDim2.fromOffset(57, 204), Size = UDim2.fromOffset(162, 32), BackgroundColor3 = Theme.InputBg,
                BorderSizePixel = 0, ZIndex = 2, Parent = body,
            })
            corner(boxHolder, 9)
            local boxStroke = newT("UIStroke", {
                Color = Theme.Stroke, Transparency = 0.4, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = boxHolder,
            })
            hexBox = newT("TextBox", {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), ZIndex = 3,
                Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Text, PlaceholderText = "#RRGGBB",
                PlaceholderColor3 = Theme.SubText2, Text = c2hex(current), ClearTextOnFocus = false,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = boxHolder,
            })
            table.insert(conns, hexBox.Focused:Connect(function() tween(boxStroke, 0.15, { Color = Theme.Accent, Transparency = 0.1 }) end))
            table.insert(conns, hexBox.FocusLost:Connect(function()
                tween(boxStroke, 0.2, { Color = Theme.Stroke, Transparency = 0.4 })
                local c = hex2c(hexBox.Text)
                if c then H, S, V = c2hsv(c); applyColor(true) else hexBox.Text = c2hex(current) end
            end))

            for i, pc in ipairs(PRESETS) do
                local b = newT("TextButton", {
                    AutoButtonColor = false, Text = "", BackgroundColor3 = pc, BorderSizePixel = 0, ZIndex = 2,
                    Position = UDim2.fromOffset(15 + (i - 1) * (204 - 20) / 7, 250), Size = UDim2.fromOffset(20, 20), Parent = body,
                })
                corner(b, 999)
                newT("UIStroke", { Color = WHITE, Transparency = 0.75, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
                table.insert(conns, b.MouseButton1Click:Connect(function() H, S, V = c2hsv(pc); applyColor(true) end))
                table.insert(conns, b.MouseEnter:Connect(function() tween(b, 0.1, { Size = UDim2.fromOffset(23, 23), Position = UDim2.fromOffset(13.5 + (i - 1) * (204 - 20) / 7, 248.5) }) end))
                table.insert(conns, b.MouseLeave:Connect(function() tween(b, 0.12, { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(15 + (i - 1) * (204 - 20) / 7, 250) }) end))
            end

            local function dragSV(pos)
                local ap, as = svBase.AbsolutePosition, svBase.AbsoluteSize
                if as.X < 4 or as.Y < 4 then return end
                S = math.clamp((pos.X - ap.X) / as.X, 0, 1)
                V = 1 - math.clamp((pos.Y - ap.Y) / as.Y, 0, 1)
                applyColor(true)
            end
            local function dragHue(pos)
                local ap, as = hueBar.AbsolutePosition, hueBar.AbsoluteSize
                if as.X < 4 then return end
                H = math.clamp((pos.X - ap.X) / as.X, 0, 0.9999)
                applyColor(true)
            end
            table.insert(conns, svHit.InputBegan:Connect(function(input)
                if isPointerStart(input) then dragging = "sv"; dragSV(screenPos(input)) end
            end))
            table.insert(conns, hueHit.InputBegan:Connect(function(input)
                if isPointerStart(input) then dragging = "hue"; dragHue(screenPos(input)) end
            end))
            table.insert(conns, UserInputService.InputChanged:Connect(function(input)
                if not dragging or not isPointerMove(input) then return end
                if dragging == "sv" then dragSV(screenPos(input)) else dragHue(screenPos(input)) end
            end))
            table.insert(conns, UserInputService.InputEnded:Connect(function(input)
                if dragging and isPointerStart(input) then dragging = nil end
            end))

            popup.Show()
            tween(swStroke, 0.2, { Color = Theme.Accent, Transparency = 0.2 })
            registerPopup(closePopup)
            table.insert(conns, RunService.RenderStepped:Connect(function()
                if not popup or not popup.Alive() or not swatchBtn.Parent or not main.Visible then closePopup() return end
                local center = swatchBtn.AbsolutePosition + swatchBtn.AbsoluteSize / 2
                if not isInside(center, page.Page) then closePopup() return end
                popup.Place(popupPlacement(swatchBtn, POPUP_W, POPUP_H))
            end))
        end
        trackConn(swatchBtn.MouseButton1Click:Connect(function()
            if popup then closePopup() else openPopup() end
        end))

        local obj = {
            Get = function() return current end,
            GetHex = function() return c2hex(current) end,
            GetHSV = function() return H, S, V end,
            Set = function(c) if typeof(c) == "Color3" then H, S, V = c2hsv(c); applyColor(true) end end,
            SetSilent = function(c) if typeof(c) == "Color3" then H, S, V = c2hsv(c); applyColor(false) end end,
            SetHex = function(str) local c = hex2c(str) if c then H, S, V = c2hsv(c); applyColor(true) return true end return false end,
            GetSave = function() return c2hex(current) end,
            SetSave = function(str) local c = hex2c(str) if c then H, S, V = c2hsv(c); applyColor(true) end end,
            Close = closePopup, Button = swatchBtn, Card = card, Title = titleLabel, Description = descLabel, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }
        register("ColorPickers", opts.Id, obj, opts.Aliases)
        return obj
    end

    local STYLE_COLORS = {
        success = function() return Theme.Success end, danger = function() return Theme.Danger end,
        warning = function() return Theme.Warning end, ghost = function() return Theme.Card2 end,
    }

    local function clearBaseColor(btn)
        btn:SetAttribute("N0BD_BaseR", nil)
        btn:SetAttribute("N0BD_BaseG", nil)
        btn:SetAttribute("N0BD_BaseB", nil)
        local parts = btnParts[btn]
        if parts then local seq = buttonSeq(btn, Theme); parts.Grad.Color = seq end
    end
    Ext.StyleColors, Ext.ClearBase = STYLE_COLORS, clearBaseColor

    function Ext.AddButtonRow(page, buttons, options)
        local opts = readOptions(options, "ButtonRow")
        if type(buttons) ~= "table" or #buttons == 0 then error("ButtonRow needs at least one button") end
        local n = #buttons
        local slot, card, _, ctl = cardBase(page, "ButtonRowCard", opts.Height or 64)
        local gap = 10
        local result = {}
        for i, def in ipairs(buttons) do
            local holder, btn = gradButton(card, {
                Name = "RowButton" .. i, Text = tostring(def.Text or "Button"), TextSize = def.TextSize or 12,
                Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(1 / n, -gap * (n - 1) / n, 0, BTN_H + 6), Radius = BTN_RADIUS,
            })
            ctl.Hook(btn)
            local style = string.lower(tostring(def.Style or "primary"))
            if STYLE_COLORS[style] then setButtonBaseColor(btn, STYLE_COLORS[style]()) end
            local enabled = true
            local cbs = {}
            if def.Callback then table.insert(cbs, def.Callback) end
            trackConn(btn.MouseButton1Click:Connect(function()
                if not enabled then return end
                for _, fn in ipairs(copyList(cbs)) do task.spawn(fn) end
            end))
            local id = def.Id or (opts.Id .. "_" .. i)
            local o = {
                Card = card, Button = btn, Holder = holder, Slot = slot,
                GetText = function() return btn.Text end, SetText = function(v) btn.Text = tostring(v) end,
                SetBaseColor = function(c) setButtonBaseColor(btn, c) end,
                SetStyle = function(st)
                    st = string.lower(tostring(st))
                    if STYLE_COLORS[st] then setButtonBaseColor(btn, STYLE_COLORS[st]()) else clearBaseColor(btn) end
                end,
                Click = function(cb) table.insert(cbs, cb) return { Disconnect = function() for k, f in ipairs(cbs) do if f == cb then table.remove(cbs, k) break end end end } end,
                SetEnabled = function(on)
                    enabled = on ~= false
                    btn.Active = enabled
                    tween(btn, 0.15, { TextTransparency = enabled and 0 or 0.55 })
                    tween(holder:FindFirstChild("Fill") or holder, 0.15, { BackgroundTransparency = enabled and 0 or 0.5 })
                end,
                IsEnabled = function() return enabled end,
                IsVisible = function() return holder.Visible end,
                SetVisible = function(v) holder.Visible = v and true or false end,
            }
            result[i] = register("Buttons", id, o)
        end
        register("Cards", opts.Id, { Card = card, Slot = slot, Buttons = result })
        return result
    end

    function Ext.AddConfirmButton(page, titleText, descText, buttonText, callback, options)
        local opts = readOptions(options, titleText)
        local timeout = tonumber(opts.Timeout) or 3
        local confirmText = tostring(opts.ConfirmText or "Sure?")
        buttonText = tostring(buttonText or "RUN")
        local card, btn = createActionCard(page, titleText, descText, buttonText, opts)
        local o = getRegistered("Buttons", opts.Id)
        local cbs = {}
        if callback then table.insert(cbs, callback) end
        local armed, token = false, 0

        local function disarm()
            armed = false
            token = token + 1
            clearBaseColor(btn)
            btn.Text = buttonText
        end
        trackConn(btn.MouseButton1Click:Connect(function()
            if not armed then
                armed = true
                token = token + 1
                local mine = token
                setButtonBaseColor(btn, Theme.Danger)
                task.spawn(function()
                    local left = timeout
                    while armed and token == mine and left > 0 do
                        btn.Text = confirmText .. " " .. math.ceil(left)
                        task.wait(0.25)
                        left = left - 0.25
                    end
                    if armed and token == mine then disarm() end
                end)
            else
                disarm()
                for _, fn in ipairs(copyList(cbs)) do task.spawn(fn) end
                Ext.emit(opts.Id, true)
            end
        end))
        if o then
            o.Click = function(cb)
                table.insert(cbs, cb)
                return { Disconnect = function() for k, f in ipairs(cbs) do if f == cb then table.remove(cbs, k) break end end end }
            end
            o.Disarm = disarm
            o.IsArmed = function() return armed end
            o.SetText = function(v) buttonText = tostring(v); if not armed then btn.Text = buttonText end end
        end
        return card, btn
    end

    function Ext.AddProgress(page, titleText, descText, min, max, value, options)
        local opts = readOptions(options, titleText)
        titleText = tostring(titleText or "")
        min, max = tonumber(min) or 0, tonumber(max) or 100
        local suffix = tostring(opts.Suffix or "%")
        local slot, card, _, ctl = cardBase(page, (titleText:gsub("%s+", "")) .. "ProgressCard", 68)
        local titleLabel = cardTitle(card, titleText, 90)
        local valueLabel = textLabel({
            AnchorPoint = Vector2.new(1, 0), Size = UDim2.fromOffset(86, 20), Position = UDim2.new(1, 0, 0, 0),
            Text = "", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = "Accent",
            TextXAlignment = Enum.TextXAlignment.Right, Parent = card,
        })
        local descLabel = cardDesc(card, tostring(descText or ""), 0, 22, 16)
        local bar = new("Frame", {
            Name = "Track", Position = UDim2.new(0, 0, 1, -16), Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = "InputBg",
            BorderSizePixel = 0, Parent = card,
        })
        corner(bar, 999)
        stroke(bar, "Stroke", 0.65, 1)
        local fill = new("Frame", {
            Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = bar,
        })
        corner(fill, 999)
        accentGradient(fill, 0)

        local cur, customText = min, nil
        local function render(animate)
            local rel = (max > min) and math.clamp((cur - min) / (max - min), 0, 1) or 0
            tween(fill, animate and 0.3 or 0, { Size = UDim2.new(rel, 0, 1, 0) })
            valueLabel.Text = customText or (suffix == "%" and (math.floor(rel * 100 + 0.5) .. "%") or (tostring(cur) .. suffix))
        end
        cur = math.clamp(tonumber(value) or min, math.min(min, max), math.max(min, max))
        render(false)

        local obj = {
            Get = function() return cur end,
            Set = function(v, animate)
                cur = math.clamp(tonumber(v) or cur, math.min(min, max), math.max(min, max))
                render(animate ~= false)
                Ext.emit(opts.Id, cur)
            end,
            SetRange = function(a, b) min, max = tonumber(a) or min, tonumber(b) or max; render(true) end,
            SetText = function(t) customText = t ~= nil and tostring(t) or nil; render(false) end,
            SetDescription = function(t) descLabel.Text = tostring(t) end,
            Card = card, Title = titleLabel, Value = valueLabel, Fill = fill, Slot = slot,
            IsVisible = function() return slot.Visible end,
            SetVisible = function(v) slot.Visible = v and true or false end,
        }
        register("Bars", opts.Id, obj, opts.Aliases)
        return obj
    end

    function Ext.AddParagraph(page, titleText, bodyText, options)
        local opts = readOptions(options, titleText)
        local kinds = { info = "Accent", success = "Success", warning = "Warning", error = "Danger" }
        local kind = string.lower(tostring(opts.Kind or "info"))
        local card = createCard(page, "ParagraphCard", { Id = opts.Id .. "Card" })
        local reg = getRegistered("Cards", opts.Id .. "Card")
        if reg and reg.List then reg.List.Padding = UDim.new(0, 6) end

        local head = newT("Frame", {
            Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = card,
        })
        local badge = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = kinds[kind] or "Accent", BorderSizePixel = 0, Parent = head,
        })
        corner(badge, 999)
        local glyph = textLabel({
            Size = UDim2.fromScale(1, 1), Text = (kind == "info") and "i" or "!", Visible = kind ~= "success",
            Font = Enum.Font.GothamBlack, TextSize = 11, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Parent = badge,
        })
        local checkMark = drawCheck(badge, WHITE, 11)
        checkMark.Visible = kind == "success"
        local titleLabel = textLabel({
            Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -28, 1, 0), Text = tostring(titleText or ""),
            Font = Enum.Font.GothamBold, TextSize = 14, Parent = head,
        })
        local body = textLabel({
            Name = "Body", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
            Text = tostring(bodyText or ""), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = "SubText",
            TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = card,
        })
        local obj
        obj = {
            GetValue = function() return body.Text end,
            SetValue = function(t) body.Text = tostring(t) end,
            GetText = function() return body.Text end, SetText = function(t) body.Text = tostring(t) end,
            SetTitle = function(t) titleLabel.Text = tostring(t) end,
            SetKind = function(k)
                k = string.lower(tostring(k))
                if not kinds[k] then return end
                badge.BackgroundColor3 = Theme[kinds[k]]
                glyph.Text = (k == "info") and "i" or "!"
                glyph.Visible = k ~= "success"
                checkMark.Visible = k == "success"
            end,
            Title = titleLabel, Value = body, Card = card, Slot = card.Parent,
            IsVisible = function() return card.Parent.Visible end,
            SetVisible = function(v) card.Parent.Visible = v and true or false end,
        }
        register("Labels", opts.Id, obj, opts.Aliases)
        return obj
    end
    end

    do
        Ext.Overrides = {}
        local overrides = Ext.Overrides

        local function toColor(v)
            if typeof(v) == "Color3" then return v end
            if type(v) == "table" and #v >= 3 then
                local r, g, b = v[1], v[2], v[3]
                if r > 1 or g > 1 or b > 1 then return Color3.fromRGB(r, g, b) end
                return Color3.new(r, g, b)
            end
            if type(v) == "string" then
                local hex = v:gsub("^#", "")
                if #hex == 6 and not hex:find("%X") then
                    return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
                end
            end
            return nil
        end

        local function setInstanceText(inst, v)
            if typeof(inst) == "Instance" then inst.Text = tostring(v) return true end
            return false
        end

        local function setVisible(o, v)
            v = v ~= false
            if o.SetVisible then o.SetVisible(v) return end
            local target = o.Slot or o.Card
            if typeof(target) == "Instance" then target.Visible = v end
        end

        local function applyProps(o, p, id, onlyLate)
            local function try(fn, ...) pcall(fn, ...) end
            if not onlyLate then
                local d = p.Value
                if d == nil then d = p.Default end
                if d ~= nil then
                    local was = Ext.Loading
                    Ext.Loading = true
                    local setter = o.SetSave or o.Set or o.Select
                    if setter then try(setter, d) end
                    Ext.Loading = was
                end
                if p.Options and o.SetOptions then try(o.SetOptions, p.Options) end
            end
            local text = p.Text; if text == nil then text = p.ButtonText end
            if text ~= nil and o.SetText then try(o.SetText, text) end
            if p.Title ~= nil then
                if o.SetTitle then try(o.SetTitle, p.Title) else try(setInstanceText, o.Title, p.Title) end
            end
            local desc = p.Description; if desc == nil then desc = p.Desc end
            if desc ~= nil then try(setInstanceText, o.Description, desc) end
            if p.Style ~= nil then
                if o.SetStyle then try(o.SetStyle, p.Style)
                elseif typeof(o.Button) == "Instance" then
                    local st = string.lower(tostring(p.Style))
                    local fn = Ext.StyleColors[st]
                    try(function()
                        if fn then setButtonBaseColor(o.Button, fn()) else Ext.ClearBase(o.Button) end
                    end)
                end
            end
            if p.Color ~= nil then
                local c = toColor(p.Color)
                if c and o.SetBaseColor then try(o.SetBaseColor, c) end
            end
            local vis = p.Visible; if vis == nil and p.Hidden ~= nil then vis = not p.Hidden end
            if vis ~= nil then try(setVisible, o, vis) end
            local en = p.Enabled; if en == nil and p.Disabled ~= nil then en = not p.Disabled end
            if en ~= nil and o.SetEnabled then try(o.SetEnabled, en) end
            local cb = p.Callback; if cb == nil then cb = p.OnClick end
            if cb ~= nil and o.Click then try(o.Click, cb) end
            if p.OnChanged ~= nil and id then try(Ext.OnChanged, id, p.OnChanged) end
        end

        local prevHook = registerHook
        registerHook = function(kind, id, object)
            local p = overrides[id]
            if p then
                task.defer(function() applyProps(object, p, id) end)
            end
            if prevHook then return prevHook(kind, id, object) end
        end

        function Ext.Configure(id, props)
            if type(props) ~= "table" then return false end
            id = componentId(id)
            local cur = overrides[id]
            if not cur then cur = {}; overrides[id] = cur end
            for k, v in pairs(props) do cur[k] = v end
            local o = getRegistered(nil, id)
            if o then applyProps(o, props, id) return true end
            return false
        end

        function Ext.Define(map)
            if type(map) ~= "table" then return 0 end
            local n = 0
            if #map > 0 then
                for _, def in ipairs(map) do
                    if type(def) == "table" and (def.Id or def.ID) then
                        Ext.Configure(def.Id or def.ID, def)
                        n = n + 1
                    end
                end
            end
            for id, props in pairs(map) do
                if type(id) == "string" and type(props) == "table" then
                    Ext.Configure(id, props)
                    n = n + 1
                end
            end
            return n
        end

        function Ext.ClearOverrides(id)
            if id == nil then
                for k in pairs(overrides) do overrides[k] = nil end
            else
                overrides[componentId(id)] = nil
            end
        end

        function Ext.GetOverrides(id)
            if id ~= nil then return overrides[componentId(id)] end
            return overrides
        end

        function Ext.LoadDefinitions(src)
            local data = src
            if type(src) == "function" then
                local ok, res = pcall(src)
                if not ok then return 0, tostring(res) end
                data = res
            elseif type(src) == "string" then
                local code = src
                if src:match("^https?://") then
                    local ok, res = pcall(function() return game:HttpGet(src) end)
                    if not ok then return 0, tostring(res) end
                    code = res
                elseif type(isfile) == "function" and #src < 260 and not src:find("\n") and isfile(src) then
                    code = readfile(src)
                end
                local fn, err = loadstring(code)
                if not fn then return 0, tostring(err) end
                local ok, res = pcall(fn)
                if not ok then return 0, tostring(res) end
                data = res
            end
            if type(data) ~= "table" then return 0, "keine Tabelle" end
            return Ext.Define(data.Buttons or data.Components or data)
        end

        local builders = {
            header   = function(pg, d) return createHeader(pg, d.Title or d.Text or "", d) end,
            divider  = function(pg, d) return createDivider(pg, d) end,
            label    = function(pg, d) return createLabelCard(pg, d.Title or "", d.Value or d.Text or "", d) end,
            toggle   = function(pg, d) return createToggleCard(pg, d.Title, d.Desc or d.Description, d.Default == true or d.Value == true, d.Callback, d) end,
            slider   = function(pg, d) return createSliderCard(pg, d.Title, d.Desc or d.Description, d.Min or 0, d.Max or 100, d.Default or d.Value or d.Min or 0, d.Callback, d) end,
            button   = function(pg, d)
                local card, btn = createActionCard(pg, d.Title, d.Desc or d.Description, d.Text or d.ButtonText or "RUN", d)
                local o = getRegistered("Buttons", d.Id or d.Title)
                if o and d.Callback then o.Click(d.Callback) end
                return card, btn
            end,
            dropdown = function(pg, d) return createDropdownCard(pg, d.Title, d.Items or d.Options or {}, d.Default or d.Value, d.Callback, d) end,
            input    = function(pg, d) return createTextInputCard(pg, d.Title, d.Placeholder or "", d.Text or d.ButtonText or "SET", d.Callback, d) end,
            search   = function(pg, d) return createSearchListCard(pg, d.Title, d.Items or {}, d.Callback, d) end,
            keybind  = function(pg, d) return Ext.AddKeybind(pg, d.Title, d.Desc or d.Description, d.Default or d.Value, d.Callback, d) end,
            color    = function(pg, d) return Ext.AddColorPicker(pg, d.Title, d.Desc or d.Description, d.Default or d.Value, d.Callback, d) end,
            segmented = function(pg, d) return Ext.AddSegmented(pg, d.Title, d.Desc or d.Description, d.Items or {}, d.Default or d.Value, d.Callback, d) end,
            multidropdown = function(pg, d) return Ext.AddMultiDropdown(pg, d.Title, d.Items or {}, d.Defaults or d.Default or {}, d.Callback, d) end,
            buttonrow = function(pg, d) return Ext.AddButtonRow(pg, d.Buttons or {}, d) end,
            confirm  = function(pg, d) return Ext.AddConfirmButton(pg, d.Title, d.Desc or d.Description, d.Text or d.ButtonText or "RUN", d.Callback, d) end,
            progress = function(pg, d) return Ext.AddProgress(pg, d.Title, d.Desc or d.Description, d.Min or 0, d.Max or 100, d.Value or 0, d) end,
            paragraph = function(pg, d) return Ext.AddParagraph(pg, d.Title, d.Body or d.Text or "", d) end,
        }
        builders.action, builders.switch, builders.select = builders.button, builders.toggle, builders.dropdown
        builders.colorpicker, builders.selector, builders.info = builders.color, builders.segmented, builders.paragraph
        builders.confirmbutton, builders.row, builders.text, builders.textbox = builders.confirm, builders.buttonrow, builders.input, builders.input
        builders.searchlist, builders.list, builders.bar = builders.search, builders.search, builders.progress

        function Ext.Build(page, defs)
            if type(defs) ~= "table" then error("Build needs a list of definitions") end
            local out = {}
            for i, d in ipairs(defs) do
                if type(d) == "table" then
                    local kind = string.lower(tostring(d.Type or d.Kind or "button"))
                    local build = builders[kind]
                    if not build then
                        warn(("Build: unknown type '%s' (entry %d)"):format(kind, i))
                    else
                        local def = {}
                        for k, v in pairs(d) do def[k] = v end
                        if def.Id == nil and def.ID == nil and def.Name == nil then def.Id = def.Title or def.Text end
                        local ok, a = pcall(build, page, def)
                        if not ok then
                            warn(("Build: entry %d (%s) failed: %s"):format(i, kind, tostring(a)))
                        else
                            local obj = def.Id and getRegistered(nil, def.Id) or nil
                            if obj then
                                local late = {}
                                for _, k in ipairs({ "Visible", "Hidden", "Enabled", "Disabled", "Style", "Color", "OnChanged" }) do late[k] = def[k] end
                                applyProps(obj, late, componentId(def.Id), true)
                                if def.Id then out[componentId(def.Id)] = obj end
                            end
                            out[#out + 1] = obj or a
                        end
                    end
                end
            end
            return out
        end
        function Ext.Remove(id)
            id = componentId(id)
            local o = Components.All[id]
            if not o then return false end
            local slot = o.Slot
            if typeof(slot) ~= "Instance" and typeof(o.Card) == "Instance" then slot = o.Card.Parent end
            for _, group in pairs(Components) do
                if type(group) == "table" then
                    for key, value in pairs(group) do
                        if value == o then group[key] = nil end
                    end
                end
            end
            overrides[id] = nil
            if typeof(slot) == "Instance" then
                for _, page in pairs(Components.Pages) do
                    if type(page) == "table" and type(page.Slots) == "table" then
                        for i = #page.Slots, 1, -1 do
                            if page.Slots[i].Slot == slot then table.remove(page.Slots, i) end
                        end
                    end
                end
                slot:Destroy()
            end
            return true
        end
    end

    local setFx
    do
    local fxEnabled = true
    local fxTime, fpsAcc, fpsFrames = 0, 0, 0

    setFx = function(on)
        fxEnabled = on and true or false
        fx.Visible = fxEnabled
    end
    setFx(opt("Effects", true) ~= false)

    local function readPing()
        if not StatsService then return nil end
        local ok, v = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and v then return math.floor(v + 0.5) end
        return nil
    end

    trackConn(RunService.Heartbeat:Connect(function(dt)
        fxTime = fxTime + dt
        Canvas.sync(effScale())
        if main.Visible and gui.Enabled then discordTick(fxTime) end

        if main.Visible and gui.Enabled then
            borderGrad.Rotation = (borderGrad.Rotation + dt * 45) % 360

            if fxEnabled then
                orbA.Position = UDim2.new(0.16 + math.sin(fxTime * 0.25) * 0.06, 0, 0.10 + math.cos(fxTime * 0.21) * 0.06, 0)
                orbB.Position = UDim2.new(0.88 + math.cos(fxTime * 0.19) * 0.05, 0, 0.94 + math.sin(fxTime * 0.23) * 0.05, 0)
                orbC.Position = UDim2.new(0.55 + math.sin(fxTime * 0.15 + 1) * 0.1, 0, 0.5 + math.cos(fxTime * 0.17) * 0.1, 0)
                for _, p in ipairs(particles) do
                    p.y = p.y - p.speed * dt
                    if p.y < -0.04 then p.y = 1.04; p.x = math.random() end
                    local x = p.x + math.sin(fxTime * 0.6 + p.phase) * p.sway
                    p.dot.Position = UDim2.fromScale(x, p.y)
                    p.dot.BackgroundTransparency = 0.55 + 0.35 * (0.5 + 0.5 * math.sin(fxTime * 1.3 + p.phase))
                end
            end

            fpsAcc = fpsAcc + dt
            fpsFrames = fpsFrames + 1
            if fpsAcc >= 0.5 then
                local fps  = math.floor(fpsFrames / fpsAcc + 0.5)
                local ping = readPing()
                statLabel.Text = tostring(fps) .. " FPS | " .. (ping and tostring(ping) or "--") .. " ms"
                local col = (fps >= 50 and Theme.Success) or (fps >= 30 and Theme.Warning) or Theme.Danger
                tween(statDot, 0.3, { BackgroundColor3 = col })
                fpsAcc, fpsFrames = 0, 0
            end
        end

        if miniFrame.Visible then
            local ph = (fxTime * 0.9) % 1
            miniRing.Size = UDim2.fromOffset(12 + 12 * ph, 12 + 12 * ph)
            miniRing:FindFirstChildOfClass("UIStroke").Transparency = 0.25 + 0.75 * ph
        end
    end))

    end

    local mainPage = createTab("Main", CONFIG.TAB_ICON_MAIN)

    createHeader(mainPage, "UI Settings", "UISettingsHeader")
    createSliderCard(mainPage, "UI Scale", "Resize the hub window (80 - 120%)", 80, 120, math.floor(userScale * 100 + 0.5), function(value)
        userScale = value / 100
        applyScale(true)
    end, { Id = "UIScale", Suffix = "%" })

    createDropdownCard(mainPage, "Theme", PresetOrder, Theme.Name, function(name)
        setTheme(name, true)
        if not Ext.Loading then showToast("Theme: " .. tostring(name), "success") end
    end, "UITheme")

    createToggleCard(mainPage, "Background Effects", "Animated glow and floating particles. Turn off for maximum performance.", fx.Visible, function(on)
        setFx(on)
    end, "BackgroundFX")

    do
        local toggleLabel = createLabelCard(mainPage, "Toggle Key", TOGGLE_KEY.Name, "ToggleKeyLabel")
        toggleLabel.SetVisible(false)
        local DEFAULT_TOGGLE = TOGGLE_KEY
        local kb
        local function applyToggleKey(key)
            TOGGLE_KEY = key
            toggleLabel.SetValue(key.Name)
            if miniSub then miniSub.Text = key.Name end
            local api = getgenv().N0BD_UI
            if api then api.ToggleKey = key end
        end
        kb = Ext.AddKeybind(mainPage, "Toggle Key", "Show / hide the hub. Click, then press a new key.", TOGGLE_KEY,
            function(item, name)
                if item and name and not tostring(name):find("^MouseButton") then
                    applyToggleKey(item)
                else

                    applyToggleKey(DEFAULT_TOGGLE)
                    kb.SetSilent(DEFAULT_TOGGLE)
                    showToast("Toggle key reset to " .. DEFAULT_TOGGLE.Name, "info")
                end
            end, { Id = "ToggleKeyBind" })
    end

    createDivider(mainPage, "MainDivider1")
    createHeader(mainPage, "Script Settings", "ConfigHeader")
    do
        local nameInput = createTextInputCard(mainPage, "Config Name", "default", "SET", function(v)
            Ext.SetConfigName(v)
        end, { Id = "ConfigName" })
        nameInput.NoSave = true
        nameInput.TextBox.Text = Ext.ConfigName
        createToggleCard(mainPage, "Auto Save", "Saves the script settings automatically a moment after every change.", Ext.AutoSave, function(on)
            Ext.SetAutoSave(on)
        end, { Id = "ConfigAutoSave" }).NoSave = true
        local function report(ok, okMsg, failMsg)
            showToast(ok and okMsg or failMsg, ok and "success" or "error")
        end
        Ext.AddButtonRow(mainPage, {
            { Text = "SAVE", Style = "success", Id = "ConfigSave", Callback = function()
                local ok, res = Ext.SaveConfig()
                report(ok, "Config saved: " .. Ext.ConfigName, "Save failed: " .. tostring(res))
            end },
            { Text = "LOAD", Id = "ConfigLoad", Callback = function()
                local ok, res = Ext.LoadConfig()
                report(ok, "Config loaded: " .. Ext.ConfigName .. " (" .. tostring(res) .. " values)", "Load failed: " .. tostring(res))
            end },
            { Text = "COPY JSON", Style = "ghost", Id = "ConfigCopy", Callback = function()
                local copier = setclipboard or toclipboard
                local ok = copier and pcall(copier, Ext.GetConfigJSON()) and true or false
                report(ok, "Config copied!", "Clipboard not available")
            end },
        }, { Id = "ConfigButtons" })
    end

    createDivider(mainPage, "MainDivider1b")
    createHeader(mainPage, "Delete Settings", "DeleteHeader")
    do
        local TARGETS = { "UI Settings", "Script Settings" }
        local target = TARGETS[1]
        local armed, armToken = false, 0
        local descText = function() return Ext.GetSettingsPath(target) end
        local disarm
        local dd = createDropdownCard(mainPage, "Settings Type", TARGETS, target, function(v)
            target = v
            if disarm then disarm() end
        end, { Id = "DeleteTarget" })
        dd.NoSave = true
        local _, btn = createActionCard(mainPage, "Delete Settings", "", "DELETE", { Id = "DeleteSettings" })
        local action = getRegistered("Buttons", "DeleteSettings")
        action.Description.Text = descText()
        disarm = function()
            armed = false
            armToken = armToken + 1
            btn.Text = "DELETE"
            action.Description.Text = descText()
        end
        trackConn(btn.MouseButton1Click:Connect(function()
            if not armed then
                armed = true
                armToken = armToken + 1
                local mine = armToken
                btn.Text = "CONFIRM"
                action.Description.Text = "Click again to delete " .. target
                task.delay(3, function() if armed and mine == armToken then disarm() end end)
                return
            end
            local name = target
            disarm()
            local ok = Ext.DeleteSettings(name)
            showToast(ok and (name .. " deleted") or ("No " .. name .. " found"), ok and "success" or "warning")
        end))
        Ext.Configure("DeleteSettings", { Style = "danger" })
    end

    createDivider(mainPage, "MainDivider2")
    createHeader(mainPage, "Utilities", "UtilitiesHeader")

    local _, rejoinBtn = createActionCard(mainPage, "Rejoin Same Server", "Rejoins this exact server using current JobId.", "REJOIN", "RejoinSameServer")
    trackConn(rejoinBtn.MouseButton1Click:Connect(function()
        rejoinBtn.Text = "REJOINING..."
        task.delay(0.15, function()
            local ok, err = pcall(function()
                if game.JobId ~= "" then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
                else
                    TeleportService:Teleport(game.PlaceId, player)
                end
            end)
            if not ok then
                rejoinBtn.Text = "REJOIN"
                showToast("Rejoin failed: " .. tostring(err), "error")
            end
        end)
    end))

    do
        local antiEnabled, antiThread = false, nil
        local function stopAntiAfk()
            antiEnabled = false
            if antiThread then task.cancel(antiThread); antiThread = nil end
        end
        local function startAntiAfk()
            stopAntiAfk()
            antiEnabled = true
            antiThread = task.spawn(function()
                while antiEnabled do
                    task.wait(ANTI_AFK_INTERVAL)
                    if not antiEnabled then break end
                    local character = player.Character
                    if character then
                        local hum = character:FindFirstChildOfClass("Humanoid")
                        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping); hum.Jump = true end
                    end
                    showToast("Anti-AFK: pulse sent", "info")
                end
            end)
        end
        createToggleCard(mainPage, "Anti-AFK", ("Jump pulse every %d sec. Keeps you in-game."):format(ANTI_AFK_INTERVAL), false, function(enabled)
            if enabled then startAntiAfk() else stopAntiAfk() end
            if not Ext.Loading then
                if enabled then showToast("Anti-AFK enabled", "success") else showToast("Anti-AFK disabled", "info") end
            end
        end, "AntiAFK")
    end

    local minimized, busy = false, false
    local savedPos = main.Position

    setMinimized = function(on)
        if busy or minimized == on then return end
        busy = true
        minimized = on
        closeAllDropdowns()

        if on then
            savedPos = main.Position
            local target = miniFrame.Position
            setShadows(false, 0.3)
            tween(window, 0.42, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tween(mainScale, 0.46, { Scale = 0.07 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            tween(main, 0.46, { Position = target }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            task.wait(0.46)
            main.Visible = false

            miniFrame.Visible = true
            miniScale.Scale = 0.6
            tween(miniScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

            local base = miniFrame.Position
            tween(miniFrame, 0.18, { Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset - 16) },
                Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            task.wait(0.18)
            tween(miniFrame, 0.55, { Position = base }, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)
            task.wait(0.3)
        else
            tween(miniScale, 0.22, { Scale = 0.8 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.wait(0.2)
            miniFrame.Visible = false

            main.Position = miniFrame.Position
            mainScale.Scale = 0.07
            window.GroupTransparency = 1
            main.Visible = true
            setShadows(true, 0.6)
            tween(window, 0.4, { GroupTransparency = 0 })
            tween(mainScale, 0.6, { Scale = effScale() }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(main, 0.55, { Position = savedPos }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            task.wait(0.55)
            clampWindow()
        end
        busy = false
    end

    local function destroyAll()
        pcall(Ext.FlushSave)
        Ext.Ready = false
        closeAllDropdowns()
        disconnectAll()
        if gui and gui.Parent then pcall(function() gui:Destroy() end) end
        local g = getgenv()
        g.N0BD_UI, g.N0BD_Toast, g.N0BD_Cleanup = nil, nil, nil
    end

    closeUi = function()
        if busy then return end
        busy = true
        closeAllDropdowns()
        setShadows(false, 0.25)
        tween(window, 0.26, { GroupTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(mainScale, 0.3, { Scale = effScale() * 0.92 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.32, destroyAll)
    end

    local function zoomToggle()
        if busy or minimized then return end
        userScale = (userScale >= 1.1) and 1 or 1.15
        applyScale(true)
        local percent = math.floor(userScale * 100 + 0.5)
        if externalSetSliderValue then externalSetSliderValue(percent) end
        showToast("Zoom " .. tostring(percent) .. "%", "info", 1.6)
    end

    trackConn(minimizeBtn.MouseButton1Click:Connect(function() setMinimized(true) end))
    trackConn(miniRestoreBtn.MouseButton1Click:Connect(function() setMinimized(false) end))
    trackConn(closeBtn.MouseButton1Click:Connect(closeUi))
    trackConn(zoomBtn.MouseButton1Click:Connect(zoomToggle))

    do
        local dragging, startPointer, startPos, moved = false, nil, nil, false
        trackConn(miniFrame.InputBegan:Connect(function(input)
            if isPointerStart(input) and minimized then
                local p = screenPos(input)
                if isInside(p, miniRestoreBtn) then return end
                dragging, moved = true, false
                startPointer, startPos = p, miniFrame.Position
            end
        end))
        trackConn(UserInputService.InputChanged:Connect(function(input)
            if dragging and isPointerMove(input) and minimized then
                local d  = screenPos(input) - startPointer
                local vp = getViewport()
                local hw, hh = MINI_SIZE.X / 2, MINI_SIZE.Y / 2
                miniFrame.Position = UDim2.fromOffset(
                    math.clamp(startPos.X.Offset + d.X, hw, vp.X - hw),
                    math.clamp(startPos.Y.Offset + d.Y, hh, vp.Y - hh)
                )
                moved = true
            end
        end))
        trackConn(UserInputService.InputEnded:Connect(function(input)
            if isPointerStart(input) then dragging = false end
        end))
    end

    do
        local dragging, startPointer, startPos = false, nil, nil
        trackConn(topbar.InputBegan:Connect(function(input)
            if not isPointerStart(input) or minimized or busy then return end
            local p = screenPos(input)
            if isInside(p, controls) or isInside(p, trafficLights) then return end
            dragging, startPointer, startPos = true, p, main.Position
        end))
        trackConn(UserInputService.InputChanged:Connect(function(input)
            if dragging and isPointerMove(input) and not minimized then
                local d = screenPos(input) - startPointer
                main.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
                clampWindow()
            end
        end))
        trackConn(UserInputService.InputEnded:Connect(function(input)
            if isPointerStart(input) and dragging then
                dragging = false
                clampWindow()
            end
        end))
    end

    trackConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == TOGGLE_KEY then setMinimized(not minimized) end
    end))

    do
        local cam = workspace.CurrentCamera
        if cam then
            trackConn(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                if not busy then applyScale(false) end
            end))
        end
    end

    getgenv().N0BD_UI = {
        Version = "12.8.0",
        Gui = gui, Main = main, Window = window, Sidebar = sidebar, Content = content,
        Theme = Theme, Pages = pages, Tabs = tabs, Components = Components,
        Buttons = Components.Buttons, Toggles = Components.Toggles, Sliders = Components.Sliders,
        Labels = Components.Labels, Cards = Components.Cards, Headers = Components.Headers,
        Dividers = Components.Dividers, Dropdowns = Components.Dropdowns, Inputs = Components.Inputs,
        Lists = Components.Lists, ToggleKey = TOGGLE_KEY,
        SetToggleKey = function(key)
            TOGGLE_KEY = key
            if getgenv().N0BD_UI then getgenv().N0BD_UI.ToggleKey = key end
            if miniSub then miniSub.Text = key.Name end
            local kbObj = getRegistered("Keybinds", "ToggleKeyBind")
            if kbObj then kbObj.SetSilent(key) end
        end,
        SetTheme = function(name) return setTheme(name, true) end,
        GetThemes = function() local t = {}; for i, n in ipairs(PresetOrder) do t[i] = n end; return t end,
        SetEffects = setFx,
        Minimize = function(on) setMinimized(on ~= false) end,
        Zoom = zoomToggle,
        AntiAfkInterval = ANTI_AFK_INTERVAL, Toast = showToast, SelectTab = selectTab,
        AddTab = createTab, RemoveTab = removeTab, CloseAllDropdowns = closeAllDropdowns,
        Get = function(id) return getRegistered(nil, id) end, GetButton = function(id) return getRegistered("Buttons", id) end,
        GetToggle = function(id) return getRegistered("Toggles", id) end, GetSwitch = function(id) return getRegistered("Toggles", id) end,
        GetSlider = function(id) return getRegistered("Sliders", id) end, GetLabel = function(id) return getRegistered("Labels", id) end,
        GetCard = function(id) return getRegistered("Cards", id) end, GetHeader = function(id) return getRegistered("Headers", id) end,
        GetDivider = function(id) return getRegistered("Dividers", id) end, GetTab = function(id) return getRegistered("Tabs", id) end,
        GetPage = function(id) return getRegistered("Pages", id) end, GetDropdown = function(id) return getRegistered("Dropdowns", id) end,
        GetInput = function(id) return getRegistered("Inputs", id) end, GetList = function(id) return getRegistered("Lists", id) end,
        ListAll = function() return Components.All end, ListButtons = function() return Components.Buttons end,
        ListToggles = function() return Components.Toggles end, ListSliders = function() return Components.Sliders end,
        ListLabels = function() return Components.Labels end, ListCards = function() return Components.Cards end,
        ListDropdowns = function() return Components.Dropdowns end, ListInputs = function() return Components.Inputs end,
        ListLists = function() return Components.Lists end,
        RegisterComponent = register, UnregisterComponent = unregister,
        ListComponents = function(kind) if kind and Components[kind] then return Components[kind] end; return Components.All end,
        AddHeader = createHeader, AddDivider = createDivider, AddCard = createCard, AddButton = createActionCard,
        AddActionCard = createActionCard, AddToggle = createToggleCard, AddSwitch = createToggleCard, AddSlider = createSliderCard,
        AddLabel = createLabelCard, AddDropdown = createDropdownCard, AddTextInput = createTextInputCard, AddList = createSearchListCard,
        AddSearchList = createSearchListCard, CreateHeader = createHeader, CreateDivider = createDivider, CreateCard = createCard,
        CreateActionCard = createActionCard, CreateToggleCard = createToggleCard, CreateSliderCard = createSliderCard,
        CreateLabelCard = createLabelCard, CreateDropdown = createDropdownCard, CreateTextInput = createTextInputCard,
        CreateList = createSearchListCard, CreateSearchList = createSearchListCard,
    }

    do
        local U = getgenv().N0BD_UI
        U.Keybinds, U.ColorPickers, U.Segments = Components.Keybinds, Components.ColorPickers, Components.Segments
        U.MultiDropdowns, U.Bars = Components.MultiDropdowns, Components.Bars

        local adders = {
            Keybind = Ext.AddKeybind, ColorPicker = Ext.AddColorPicker, Segmented = Ext.AddSegmented,
            MultiDropdown = Ext.AddMultiDropdown, ButtonRow = Ext.AddButtonRow, ConfirmButton = Ext.AddConfirmButton,
            Progress = Ext.AddProgress, Paragraph = Ext.AddParagraph,
        }
        for name, fn in pairs(adders) do
            U["Add" .. name] = fn
            U["Create" .. name] = fn
        end
        U.AddSelector, U.AddInfo = Ext.AddSegmented, Ext.AddParagraph

        local getters = {
            GetKeybind = "Keybinds", GetColorPicker = "ColorPickers", GetSegmented = "Segments",
            GetMultiDropdown = "MultiDropdowns", GetProgress = "Bars",
        }
        for fname, kind in pairs(getters) do
            U[fname] = function(id) return getRegistered(kind, id) end
        end
        U.ListKeybinds = function() return Components.Keybinds end
        U.ListColorPickers = function() return Components.ColorPickers end

        U.GetValue, U.SetValue = Ext.GetValue, Ext.SetValue
        U.OnChanged, U.OnAnyChanged = Ext.OnChanged, Ext.OnAnyChanged
        U.Click = Ext.Click
        U.OnClick = function(id, fn)
            local o = getRegistered("Buttons", id)
            if o and o.Click then return o.Click(fn) end
            return nil
        end
        U.SetButtonText = function(id, text)
            local o = getRegistered("Buttons", id)
            if o and o.SetText then o.SetText(text) return true end
            return false
        end

        U.Configure, U.Define, U.Build = Ext.Configure, Ext.Define, Ext.Build
        U.Remove, U.RemoveComponent = Ext.Remove, Ext.Remove
        U.LoadDefinitions, U.GetOverrides, U.ClearOverrides = Ext.LoadDefinitions, Ext.GetOverrides, Ext.ClearOverrides
        U.SetEnabled = function(id, on)
            local o = getRegistered(nil, id)
            if o and o.SetEnabled then o.SetEnabled(on) return true end
            return false
        end
        U.SetButtonStyle = function(id, style)
            return Ext.Configure(id, { Style = style })
        end

        if type(getgenv().N0BD_BUTTONS) == "table" then Ext.Define(getgenv().N0BD_BUTTONS) end
        if type(USER_CFG.Buttons) == "table" then Ext.Define(USER_CFG.Buttons) end
        if USER_CFG.Definitions ~= nil then
            local n, err = Ext.LoadDefinitions(USER_CFG.Definitions)
            if err then warn("n0bd.hub Definitions: " .. tostring(err)) end
        end
        U.SetVisible = function(id, visible)
            local o = getRegistered(nil, id)
            if o and o.SetVisible then o.SetVisible(visible) return true end
            return false
        end
        U.Flags = setmetatable({}, {
            __index = function(_, id) return Ext.GetValue(id) end,
            __newindex = function(_, id, v) Ext.SetValue(id, v) end,
        })

        U.ExportConfig, U.ImportConfig = Ext.ExportConfig, Ext.ImportConfig
        U.GetConfigJSON, U.LoadConfigJSON = Ext.GetConfigJSON, Ext.LoadConfigJSON
        U.SaveConfig, U.LoadConfig = Ext.SaveConfig, Ext.LoadConfig
        U.ListConfigs, U.DeleteConfig = Ext.ListConfigs, Ext.DeleteConfig
        U.SaveUi, U.LoadUi, U.DeleteSettings = Ext.SaveUi, Ext.LoadUi, Ext.DeleteSettings
        U.OnDeleteScriptSettings, U.GetSettingsPath, U.GetUiFolder = Ext.OnDeleteScriptSettings, Ext.GetSettingsPath, Ext.GetUiFolder
        U.SetAutoSave, U.GetAutoSave = function(on)
            Ext.SetAutoSave(on)
            local t = getRegistered("Toggles", "ConfigAutoSave")
            if t then t.SetSilent(Ext.AutoSave) end
        end, Ext.GetAutoSave
        U.Ready, U.OnReady, U.IsReady = Ext.FinishLoad, Ext.OnReady, function() return Ext.Ready end
        U.GetOptions = function()
            local copy = {}
            for k, v in pairs(USER_CFG) do copy[k] = v end
            copy.Title, copy.ConfigName, copy.ConfigFolder, copy.AutoSave = CONFIG.TITLE, Ext.ConfigName, Ext.GetConfigFolder(), Ext.AutoSave
            copy.UiFolder = Ext.GetUiFolder()
            return copy
        end
        U.SetConfigName, U.GetConfigName = Ext.SetConfigName, Ext.GetConfigName
        U.SetConfigFolder, U.GetConfigFolder = Ext.SetConfigFolder, Ext.GetConfigFolder

        U.Notify, U.Destroy = showToast, destroyAll
        U.Toggle = function() setMinimized(not minimized) end
        U.Show = function() setMinimized(false) end
        U.Hide = function() setMinimized(true) end
        U.IsOpen = function() return not minimized end
        U.IsMinimized = function() return minimized end
        U.GetTheme = function() return Theme.Name end
        U.GetScale = function() return math.floor(userScale * 100 + 0.5) end
        U.SetScale = function(percent)
            percent = math.clamp(tonumber(percent) or 100, 80, 120)
            local slider = getRegistered("Sliders", "UIScale")
            if slider then
                slider.Set(percent)
            else
                userScale = percent / 100
                applyScale(true)
            end
            return percent
        end
        U.GetEffects = function() return fx.Visible end
        U.GetToggleKey = function() return TOGGLE_KEY end
        U.OnThemeChanged = function(fn)
            local alive = true
            addThemeHook(function()
                if alive then pcall(fn, Theme.Name, Theme) end
                return alive
            end)
            return { Connected = true, Disconnect = function(self) alive = false; self.Connected = false end }
        end
        U.GetSettings = function()
            return {
                Theme = Theme.Name, Scale = U.GetScale(), Effects = fx.Visible,
                ToggleKey = TOGGLE_KEY.Name, Minimized = minimized,
            }
        end
    end

    getgenv().N0BD_Cleanup = destroyAll
    getgenv().N0BD_Toast = showToast

    Ext.BaseDone = true
    if Ext.UiEnabled then pcall(Ext.LoadUi) end
    Ext.UiReady = true

    applyScale(false)
    window.GroupTransparency = 1
    mainScale.Scale = effScale() * 0.9
    for _, sh in ipairs(shadows) do sh.BackgroundTransparency = 1 end
    selectTab("Main")

    task.spawn(function()
        busy = true
        RunService.RenderStepped:Wait()
        setShadows(true, 0.8)
        tween(window, 0.45, { GroupTransparency = 0 })
        tween(mainScale, 0.7, { Scale = effScale() }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        task.wait(0.6)
        introDone = true
        busy = false
        clampWindow()
        if opt("ShowLoadedToast", true) then
            showToast(CONFIG.TITLE .. " loaded  -  " .. TOGGLE_KEY.Name .. " to hide", "success", 3.4)
        end
        if opt("StartMinimized", false) then task.defer(function() setMinimized(true) end) end
    end)
end

waitForCamera()
local playerGui = waitForPlayerGui()
if not playerGui then warn("n0bd.hub: PlayerGui not found") return nil end
local ok, err = pcall(runUi, playerGui)
if not ok then warn("n0bd.hub crashed:", err) return nil end
return getgenv().N0BD_UI
