-- n0bd.hub v12.8
local CONFIG = {
    ICON_DISCORD      = "",
    FALLBACK_DISCORD  = "Discord",
    FALLBACK_MINIMIZE = "-",
    FALLBACK_CLOSE    = "X",
    FALLBACK_RESTORE  = ">",
    TAB_ICON_MAIN     = "",
}

local getgenv = getgenv or function() return _G end

local USER_CFG = type(getgenv().N0BD_CONFIG) == "table" and getgenv().N0BD_CONFIG or {}
local function opt(name, default)
    local v = USER_CFG[name]
    if v == nil then return default end
    return v
end
local function resolveKey(v, fallback)
    if typeof(v) == "EnumItem" then return v end
    if type(v) == "string" then
        local ok, k = pcall(function() return Enum.KeyCode[v] end)
        if ok and k then return k end
    end
    return fallback
end
for k in pairs(CONFIG) do
    if USER_CFG[k] ~= nil then CONFIG[k] = USER_CFG[k] end
end
CONFIG.TITLE            = tostring(opt("Title", "n0bd.hub"))
CONFIG.FALLBACK_DISCORD = tostring(opt("DiscordLabel", CONFIG.FALLBACK_DISCORD))
CONFIG.ICON_DISCORD     = tostring(opt("DiscordIcon", CONFIG.ICON_DISCORD))
CONFIG.TAB_ICON_MAIN    = tostring(opt("MainTabIcon", CONFIG.TAB_ICON_MAIN))

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService      = game:GetService("TextService")
local HttpService      = game:GetService("HttpService")
local TeleportService  = game:GetService("TeleportService")
local GuiService       = game:GetService("GuiService")
local StatsService
pcall(function() StatsService = game:GetService("Stats") end)

if getgenv().N0BD_Cleanup then
    pcall(getgenv().N0BD_Cleanup)
    getgenv().N0BD_Cleanup = nil
end

local function waitForPlayerGui()
    local player = Players.LocalPlayer
    if not player then
        Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
        player = Players.LocalPlayer
    end
    if not player then warn("n0bd.hub: LocalPlayer not found") return nil end
    return player:WaitForChild("PlayerGui", 30)
end

local function waitForCamera()
    local cam = workspace.CurrentCamera
    if cam then return cam end
    for _ = 1, 180 do
        cam = workspace.CurrentCamera
        if cam then return cam end
        RunService.RenderStepped:Wait()
    end
    return workspace.CurrentCamera
end

local function runUi(playerGui)
    local player = Players.LocalPlayer

    local WINDOW_SIZE       = Vector2.new(900, 600)
    local MINI_SIZE         = Vector2.new(318, 58)
    local TOP_H             = 52
    local RADIUS            = 14
    local SIDEBAR_W         = 200
    local GAP               = 12
    local MARGIN            = 12
    local CARD_PADDING      = 14
    local CARD_RADIUS       = 11
    local BTN_RADIUS        = 8
    local BTN_H             = 32
    local TAB_H             = 40
    local TAB_GAP           = 4
    local DISCORD_URL       = tostring(opt("DiscordUrl", "https://discord.gg/n0bd"))
    local TOGGLE_KEY        = resolveKey(opt("ToggleKey", Enum.KeyCode.RightShift), Enum.KeyCode.RightShift)
    local ANTI_AFK_INTERVAL = math.max(30, math.floor(tonumber(opt("AntiAfkInterval", 300)) or 300))

    local WHITE = Color3.new(1, 1, 1)
    local BLACK = Color3.new(0, 0, 0)
    local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

    local Presets = {
        Amethyst = { BG = rgb(18, 12, 31), Accent = rgb(166, 106, 255), Accent2 = rgb(255, 104, 222) },
        Violet   = { BG = rgb(14, 11, 33), Accent = rgb(128, 112, 255), Accent2 = rgb(196, 124, 255) },
        Orchid   = { BG = rgb(25, 10, 29), Accent = rgb(208, 102, 255), Accent2 = rgb(255, 122, 190) },
        Midnight = { BG = rgb(14, 17, 31), Accent = rgb(64, 156, 255),  Accent2 = rgb(167, 110, 255) },
    }
    local PresetOrder = { "Amethyst", "Violet", "Orchid", "Midnight" }

    local TL = { Red = rgb(255, 95, 87), Yellow = rgb(254, 188, 46), Green = rgb(40, 200, 64) }
    local TabColors = {
        rgb(255, 159, 10), rgb(191, 90, 242), rgb(255, 69, 108), rgb(48, 209, 88),
        rgb(64, 200, 224), rgb(255, 69, 58),  rgb(10, 132, 255), rgb(172, 142, 104),
    }

    local onColor
    do
        local function lin(x) return x <= 0.03928 and x / 12.92 or ((x + 0.055) / 1.055) ^ 2.4 end
        local function lum(c) return 0.2126 * lin(c.R) + 0.7152 * lin(c.G) + 0.0722 * lin(c.B) end
        local function ratio(a, b)
            local l1, l2 = lum(a), lum(b)
            if l1 < l2 then l1, l2 = l2, l1 end
            return (l1 + 0.05) / (l2 + 0.05)
        end
        local DARK_TEXT = rgb(9, 11, 18)
        onColor = function(c)
            if ratio(WHITE, c) >= ratio(DARK_TEXT, c) then return WHITE end
            return DARK_TEXT
        end
    end

    local Theme = {}

    local function applyPalette(name)
        local p = Presets[name]
        local bg, a1, a2 = p.BG, p.Accent, p.Accent2
        Theme.Name         = name
        Theme.BG           = bg
        Theme.BG2          = bg:Lerp(a1, 0.10)
        Theme.Top          = bg:Lerp(WHITE, 0.035)
        Theme.Top2         = bg
        Theme.Panel        = bg:Lerp(WHITE, 0.05)
        Theme.Panel2       = bg:Lerp(WHITE, 0.08)
        Theme.Card         = bg:Lerp(WHITE, 0.09)
        Theme.Card2        = bg:Lerp(WHITE, 0.13)
        Theme.CardHover    = bg:Lerp(WHITE, 0.15):Lerp(a1, 0.12)
        Theme.CardActive   = bg:Lerp(a1, 0.40)
        Theme.Stroke       = bg:Lerp(WHITE, 0.18)
        Theme.StrokeLight  = bg:Lerp(WHITE, 0.30):Lerp(a1, 0.25)
        Theme.Text         = rgb(241, 243, 255)
        Theme.SubText      = bg:Lerp(WHITE, 0.64)
        Theme.SubText2     = bg:Lerp(WHITE, 0.42)
        Theme.Accent       = a1
        Theme.Accent2      = a2
        Theme.AccentDeep   = bg:Lerp(a1, 0.30)
        Theme.Danger       = rgb(255, 84, 112)
        Theme.DangerLight  = rgb(255, 134, 156)
        Theme.Success      = rgb(46, 224, 150)
        Theme.Warning      = rgb(255, 196, 56)
        Theme.ToggleOn     = a1
        Theme.ToggleOff    = bg:Lerp(WHITE, 0.16)
        Theme.InputBg      = bg:Lerp(BLACK, 0.35)
        Theme.InputBgHover = bg:Lerp(WHITE, 0.07)
        Theme.OnAccent     = onColor(a1:Lerp(WHITE, 0.14))
        Theme.OnBrand      = onColor(a1:Lerp(a2, 0.5):Lerp(WHITE, 0.08))
        Theme.Overlay      = BLACK
        Theme.Glass        = Theme.Panel
        Theme.Shadow       = BLACK
    end
    applyPalette(Presets[opt("Theme", "Amethyst")] and opt("Theme", "Amethyst") or "Amethyst")

    local old = playerGui:FindFirstChild("n0bd.hub")
    if old then old:Destroy() end

    local function getViewport()
        local cam = workspace.CurrentCamera
        if cam then
            local ok, vp = pcall(function() return cam.ViewportSize end)
            if ok and vp and vp.X > 0 and vp.Y > 0 then return vp end
        end
        return Vector2.new(1920, 1080)
    end

    local function safeNumber(value, fallback)
        value = tonumber(value)
        if not value or value ~= value or value == math.huge or value == -math.huge then
            return fallback or 0
        end
        local vp    = getViewport()
        local limit = math.max(vp.X, vp.Y) * 3
        return math.clamp(value, -limit, limit)
    end

    local function safeUdim2(value)
        if typeof(value) ~= "UDim2" then return UDim2.new() end
        return UDim2.new(
            value.X.Scale, safeNumber(value.X.Offset, 0),
            value.Y.Scale, safeNumber(value.Y.Offset, 0)
        )
    end

    local function tween(instance, seconds, props, easingStyle, easingDirection)
        if not instance then return nil end
        if props.Size     then props.Size     = safeUdim2(props.Size)     end
        if props.Position then props.Position = safeUdim2(props.Position) end
        local tw = TweenService:Create(
            instance,
            TweenInfo.new(seconds, easingStyle or Enum.EasingStyle.Quart, easingDirection or Enum.EasingDirection.Out),
            props
        )
        tw:Play()
        return tw
    end

    local themeBinds = {}

    local function resolveSrc(src)
        if type(src) == "string" then return Theme[src] end
        return src(Theme)
    end

    local function isColorProp(name)
        return name == "Color" or name:sub(-6) == "Color3"
    end

    local function bindProp(inst, prop, src, track)
        local ok = pcall(function() inst[prop] = resolveSrc(src) end)
        if ok and track then
            table.insert(themeBinds, { inst = inst, prop = prop, src = src })
        end
    end

    local function build(class, props, track)
        local inst = Instance.new(class)
        local parent
        for k, v in pairs(props or {}) do
            if k == "Parent" then
                parent = v
            elseif (type(v) == "string" and isColorProp(k)) or type(v) == "function" then
                bindProp(inst, k, v, track)
            else
                inst[k] = v
            end
        end
        if parent then inst.Parent = parent end
        return inst
    end

    local function new(class, props)  return build(class, props, true)  end
    local function newT(class, props) return build(class, props, false) end

    local function corner(inst, px)
        return newT("UICorner", { CornerRadius = UDim.new(0, px or CARD_RADIUS), Parent = inst })
    end

    local function stroke(inst, color, transparency, thickness)
        return new("UIStroke", {
            Color           = color or "Stroke",
            Transparency    = transparency or 0.5,
            Thickness       = thickness or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            LineJoinMode    = Enum.LineJoinMode.Round,
            Parent          = inst,
        })
    end

    local function gradient(inst, c0, c1, rotation, transparency)
        local g = new("UIGradient", {
            Color = function(T)
                local a = type(c0) == "string" and T[c0] or c0
                local b = type(c1) == "string" and T[c1] or c1
                return ColorSequence.new(a, b)
            end,
            Rotation = rotation or 90,
            Parent   = inst,
        })
        if transparency then g.Transparency = transparency end
        return g
    end

    local function accentGradient(inst, rotation, transparency)
        return gradient(inst, "Accent", "Accent2", rotation or 0, transparency)
    end

    local function pad(inst, top, right, bottom, left)
        top    = top    or 0
        right  = right  or top
        bottom = bottom or top
        left   = left   or right
        return newT("UIPadding", {
            PaddingTop = UDim.new(0, top), PaddingRight = UDim.new(0, right),
            PaddingBottom = UDim.new(0, bottom), PaddingLeft = UDim.new(0, left),
            Parent = inst,
        })
    end

    local function textLabel(props)
        local d = {
            BackgroundTransparency = 1, BorderSizePixel = 0,
            Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = "Text",
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
            Text = "",
        }
        for k, v in pairs(props) do d[k] = v end
        return new("TextLabel", d)
    end

    local function drawCheck(parent, color, size, alpha)
        local box = newT("Frame", {
            Name = "Check", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Parent = parent,
        })
        local t = math.max(2, math.floor(size * 0.17 + 0.5))
        local function bar(cx, cy, len, rot)
            local b = newT("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx * size, cy * size),
                Size = UDim2.fromOffset(len * size + t * 0.5, t), Rotation = rot, BackgroundColor3 = color,
                BackgroundTransparency = alpha or 0, BorderSizePixel = 0, ZIndex = 5, Parent = box,
            })
            corner(b, t)
        end
        bar(0.275, 0.675, 0.354, 45)
        bar(0.625, 0.525, 0.71, -50.7)
        return box
    end

    local function fadeCheck(box, seconds, alpha)
        for _, b in ipairs(box:GetChildren()) do
            if b:IsA("Frame") then tween(b, seconds, { BackgroundTransparency = alpha }) end
        end
    end

    local function screenPos(input)
        if input and input.UserInputType == Enum.UserInputType.Touch then
            local p = input.Position
            local inset = GuiService:GetGuiInset()
            return Vector2.new(p.X + inset.X, p.Y + inset.Y)
        end
        return UserInputService:GetMouseLocation()
    end

    local function isPointerStart(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    local function isPointerMove(input)
        return input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
    end

    local function isInside(pos, instance)
        if not instance or not instance.Parent then return false end
        local ap = instance.AbsolutePosition
        local as = instance.AbsoluteSize
        return pos.X >= ap.X and pos.X <= ap.X + as.X and
               pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
    end

    local _connections = {}
    local function trackConn(conn)
        table.insert(_connections, conn)
        return conn
    end
    local function disconnectAll()
        for _, c in ipairs(_connections) do pcall(function() c:Disconnect() end) end
        table.clear(_connections)
    end

    local Components = {
        All = {}, Buttons = {}, Toggles = {}, Sliders = {}, Labels = {},
        Cards = {}, Headers = {}, Dividers = {}, Tabs = {}, Pages = {},
        Dropdowns = {}, Inputs = {}, Lists = {},
        Keybinds = {}, ColorPickers = {}, Segments = {}, MultiDropdowns = {}, Bars = {},
    }

    local function componentId(value)
        value = tostring(value or "Component"):gsub("[^%w_]", "")
        return value ~= "" and value or "Component"
    end

    local function readOptions(options, fallback)
        local opts = {}
        if typeof(options) == "table" then
            for k, v in pairs(options) do opts[k] = v end
        elseif typeof(options) == "string" then
            opts.Id = options
        end
        opts.Id = componentId(opts.Id or opts.ID or opts.Name or fallback)
        return opts
    end

    local registerHook
    local function register(kind, id, object, aliases)
        id = componentId(id)
        if typeof(object) ~= "table" then object = { Instance = object } end
        object.Id   = object.Id   or id
        object.Type = object.Type or kind
        Components.All[id] = object
        if Components[kind] then Components[kind][id] = object end
        if aliases then
            for _, alias in ipairs(aliases) do
                alias = componentId(alias)
                Components.All[alias] = object
                if Components[kind] then Components[kind][alias] = object end
            end
        end
        if registerHook then pcall(registerHook, kind, id, object) end
        return object
    end

    local function unregister(kind, id)
        id = componentId(id)
        Components.All[id] = nil
        if Components[kind] then Components[kind][id] = nil end
    end

    local function getRegistered(kind, id)
        id = componentId(id)
        if kind and Components[kind] then return Components[kind][id] end
        return Components.All[id]
    end

    local mainScale
    local selectTab, showToast, setMinimized, closeUi

    local gui = Instance.new("ScreenGui")
    gui.Name           = "n0bd.hub"
    gui.ResetOnSpawn   = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder   = 9999
    gui.Parent         = playerGui

    local openPopups = {}

    local function registerPopup(closer)
        table.insert(openPopups, closer)
    end

    local function unregisterPopup(closer)
        for i = #openPopups, 1, -1 do
            if openPopups[i] == closer then table.remove(openPopups, i) end
        end
    end

    local function closeAllDropdowns(except)
        local snapshot = {}
        for i, c in ipairs(openPopups) do snapshot[i] = c end
        for _, closer in ipairs(snapshot) do
            if closer ~= except then pcall(closer) end
        end
    end

    trackConn(gui:GetPropertyChangedSignal("Enabled"):Connect(function()
        if not gui.Enabled then closeAllDropdowns() end
    end))

    local btnParts = setmetatable({}, { __mode = "k" })

    local function shadeSeq(c)
        return ColorSequence.new(c:Lerp(WHITE, 0.2), c:Lerp(BLACK, 0.1))
    end

    local function buttonSeq(btn, T)
        local r = btn:GetAttribute("N0BD_BaseR")
        if r then
            return shadeSeq(Color3.new(r, btn:GetAttribute("N0BD_BaseG") or 0, btn:GetAttribute("N0BD_BaseB") or 0))
        end
        return shadeSeq(T.Accent)
    end

    local function setButtonBaseColor(btn, color)
        btn:SetAttribute("N0BD_BaseR", color.R)
        btn:SetAttribute("N0BD_BaseG", color.G)
        btn:SetAttribute("N0BD_BaseB", color.B)
        local parts = btnParts[btn]
        if parts then local seq = buttonSeq(btn, Theme); parts.Grad.Color = seq end
    end

    local function spawnRipple(target, radiusPx)
        if not target or not target.Parent then return end
        local m   = UserInputService:GetMouseLocation()
        local abs = target.AbsolutePosition
        local siz = target.AbsoluteSize
        local sc  = (mainScale and mainScale.Scale) or 1
        if sc <= 0 then sc = 1 end
        local rx, ry = (m.X - abs.X) / sc, (m.Y - abs.Y) / sc
        local w, h   = siz.X / sc, siz.Y / sc

        local fx = newT("CanvasGroup", {
            Name = "RippleFx", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = target,
        })
        corner(fx, radiusPx or BTN_RADIUS)

        local maxDim = math.max(w, h) * 2.4
        local ripple = newT("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(rx, ry), Size = UDim2.fromOffset(0, 0),
            BackgroundColor3 = WHITE, BackgroundTransparency = 0.7, BorderSizePixel = 0, Parent = fx,
        })
        corner(ripple, 999)
        tween(ripple, 0.6, { Size = UDim2.fromOffset(maxDim, maxDim), BackgroundTransparency = 1 })
        task.delay(0.65, function() if fx.Parent then fx:Destroy() end end)
    end

    local function gradButton(parent, o)
        local radius = o.Radius or BTN_RADIUS
        local holder = newT("Frame", {
            Name = o.Name or "ButtonHolder", BackgroundTransparency = 1,
            AnchorPoint = o.AnchorPoint or Vector2.new(0, 0),
            Position = o.Position or UDim2.new(),
            Size = o.Size or UDim2.fromOffset(100, BTN_H),
            LayoutOrder = o.LayoutOrder or 0, Parent = parent,
        })

        local btn = new("TextButton", {
            Name = "Button", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBold, TextSize = o.TextSize or 12,
            TextColor3 = "OnAccent", Text = o.Text or "", ZIndex = 4, Parent = holder,
        })

        local fill = new("Frame", {
            Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE,
            BorderSizePixel = 0, ZIndex = 1, Parent = holder,
        })
        corner(fill, radius)
        local grad = new("UIGradient", {
            Color = function(T) return buttonSeq(btn, T) end, Rotation = 90, Parent = fill,
        })

        local gloss = newT("Frame", {
            Name = "Gloss", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE,
            BorderSizePixel = 0, ZIndex = 2, Parent = holder,
        })
        corner(gloss, radius)
        newT("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.78), NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(1, 1),
            }),
            Parent = gloss,
        })

        local shine = newT("Frame", {
            Name = "Shine", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = holder,
        })
        corner(shine, radius)

        btnParts[btn] = { Fill = fill, Grad = grad, Holder = holder, Shine = shine }

        local sc = newT("UIScale", { Scale = 1, Parent = holder })
        local hovering = false
        trackConn(btn.MouseEnter:Connect(function()
            hovering = true
            tween(sc, 0.18, { Scale = 1.04 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(shine, 0.18, { BackgroundTransparency = 0.88 })
        end))
        trackConn(btn.MouseLeave:Connect(function()
            hovering = false
            tween(sc, 0.22, { Scale = 1 })
            tween(shine, 0.22, { BackgroundTransparency = 1 })
        end))
        trackConn(btn.MouseButton1Down:Connect(function()
            tween(sc, 0.08, { Scale = 0.95 }, Enum.EasingStyle.Quad)
        end))
        trackConn(btn.MouseButton1Up:Connect(function()
            tween(sc, 0.25, { Scale = hovering and 1.04 or 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end))
        trackConn(btn.MouseButton1Click:Connect(function()
            spawnRipple(holder, radius)
        end))

        return holder, btn, fill, grad
    end

    do
    local TOAST_W, TOAST_H = 344, 68
    local toastCount = 0
    local activeToasts = {}

    local toastHost = newT("Frame", {
        Name = "Toasts", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16),
        Size = UDim2.fromOffset(TOAST_W, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, ZIndex = 200, Parent = gui,
    })
    newT("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
        HorizontalAlignment = Enum.HorizontalAlignment.Right, Parent = toastHost,
    })

    local toastKinds = {
        success = { key = "Success", glyph = "", title = "Success" },
        error   = { key = "Danger",  glyph = "!", title = "Error" },
        warning = { key = "Warning", glyph = "!", title = "Warning" },
        info    = { key = "Accent",  glyph = "i", title = "Notice" },
    }

    local function detectKind(msg)
        local m = string.lower(msg)
        if m:find("fail", 1, true) or m:find("error", 1, true) or m:find("cannot", 1, true)
            or m:find("not available", 1, true) then
            return "error"
        elseif m:find("enabled", 1, true) or m:find("copied", 1, true) or m:find("success", 1, true)
            or m:find("loaded", 1, true) then
            return "success"
        elseif m:find("warn", 1, true) then
            return "warning"
        end
        return "info"
    end

    local function dismissToast(entry)
        if entry.dead then return end
        entry.dead = true
        for i = #activeToasts, 1, -1 do
            if activeToasts[i] == entry then table.remove(activeToasts, i) end
        end
        local holder, toast = entry.holder, entry.toast
        if holder and holder.Parent then
            tween(toast, 0.28, { GroupTransparency = 1, Position = UDim2.fromOffset(TOAST_W + 20, 0) },
                Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            tween(holder, 0.3, { Size = UDim2.fromOffset(TOAST_W, 0) })
            task.delay(0.34, function() if holder.Parent then holder:Destroy() end end)
        end
    end

    showToast = function(message, kind, duration)
        message  = tostring(message or "")
        kind     = toastKinds[kind] and kind or detectKind(message)
        duration = tonumber(duration) or 3
        local K     = toastKinds[kind]
        local color = Theme[K.key]

        while #activeToasts >= 4 do dismissToast(activeToasts[1]) end

        toastCount = toastCount + 1
        local holder = newT("Frame", {
            Name = "ToastHolder", BackgroundTransparency = 1,
            Size = UDim2.fromOffset(TOAST_W, 0), LayoutOrder = toastCount, Parent = toastHost,
        })
        local toast = newT("CanvasGroup", {
            Name = "Toast", BackgroundColor3 = Theme.Panel2, BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, TOAST_H), Position = UDim2.fromOffset(TOAST_W + 20, 0),
            GroupTransparency = 1, Parent = holder,
        })
        corner(toast, 17)
        newT("UIStroke", {
            Color = WHITE, Transparency = 0.88, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = toast,
        })
        local glass = newT("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = toast,
        })
        newT("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.93), NumberSequenceKeypoint.new(1, 1) }),
            Parent = glass,
        })

        local iconBox = newT("Frame", {
            Position = UDim2.fromOffset(14, 14), Size = UDim2.fromOffset(40, 40),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = toast,
        })
        corner(iconBox, 11)
        newT("UIGradient", {
            Color = ColorSequence.new(color:Lerp(WHITE, 0.25), color:Lerp(BLACK, 0.15)), Rotation = 90, Parent = iconBox,
        })
        newT("UIStroke", {
            Color = WHITE, Transparency = 0.8, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = iconBox,
        })
        if K.glyph == "" then
            drawCheck(iconBox, onColor(color), 22)
        else
            newT("TextLabel", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack,
                TextSize = 20, TextColor3 = onColor(color), Text = K.glyph, Parent = iconBox,
            })
        end

        newT("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(66, 11), Size = UDim2.new(1, -140, 0, 16),
            Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Text = CONFIG.TITLE .. "  -  " .. K.title, Parent = toast,
        })
        newT("TextLabel", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 11),
            Size = UDim2.fromOffset(50, 16), Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = Theme.SubText2,
            TextXAlignment = Enum.TextXAlignment.Right, Text = "now", Parent = toast,
        })
        newT("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(66, 29), Size = UDim2.new(1, -80, 0, 32),
            Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, Text = message, Parent = toast,
        })

        local bar = newT("Frame", {
            AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = color,
            BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = toast,
        })

        local entry = { holder = holder, toast = toast, width = TOAST_W, dead = false }
        table.insert(activeToasts, entry)

        tween(holder, 0.3, { Size = UDim2.fromOffset(TOAST_W, TOAST_H) })
        tween(toast, 0.55, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) },
            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

        task.delay(duration, function() dismissToast(entry) end)
    end
    end

    local main = newT("Frame", {
        Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(math.floor(getViewport().X / 2), math.floor(getViewport().Y / 2)),
        Size = UDim2.fromOffset(WINDOW_SIZE.X, WINDOW_SIZE.Y),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = gui,
    })
    mainScale = newT("UIScale", { Scale = 1, Parent = main })

    local shadows, setShadows = {}, nil
    do
    local SHADOW_BASE = 0.935
    for i = 1, 9 do
        local s = newT("Frame", {
            Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 22),
            Size = UDim2.new(1, i * 8 - 14, 1, i * 9 - 10), BackgroundColor3 = BLACK,
            BackgroundTransparency = SHADOW_BASE, BorderSizePixel = 0, ZIndex = 1, Parent = main,
        })
        corner(s, RADIUS + i * 4)
        shadows[i] = s
    end
    setShadows = function(visible, t)
        for _, s in ipairs(shadows) do
            tween(s, t or 0.3, { BackgroundTransparency = visible and SHADOW_BASE or 1 })
        end
    end
    end

    local window = new("CanvasGroup", {
        Name = "Window", BackgroundColor3 = "BG", BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1), GroupTransparency = 0, Active = true, ZIndex = 2, Parent = main,
    })
    local winCorner = corner(window, RADIUS)

    local winInvScale = newT("UIScale", { Scale = 1, Parent = window })
    local inner = newT("Frame", {
        Name = "Inner", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = window,
    })
    local innerScale = newT("UIScale", { Scale = 1, Parent = inner })
    local Canvas = { last = 0 }
    function Canvas.sync(s)
        s = math.max(tonumber(s) or 1, 0.1)
        if math.abs(s - Canvas.last) < 0.0005 then return end
        Canvas.last = s
        window.Size = UDim2.fromScale(s, s)
        winInvScale.Scale = 1 / s
        inner.Size = UDim2.fromScale(1 / s, 1 / s)
        innerScale.Scale = s
        winCorner.CornerRadius = UDim.new(0, math.floor(RADIUS * s + 0.5))
    end

    gradient(new("Frame", {
        Name = "Backdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, Parent = inner,
    }), "BG2", "BG", 125)

    local fx = newT("Frame", { Name = "FX", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = inner })

    local orbA, orbB, orbC
    do
    local function makeOrb(colorKey, size, strength)
        local orb = newT("Frame", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(size, size), Parent = fx,
        })
        for i = 1, 10 do
            local f = 1 - (i - 1) * 0.088
            local ring = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromScale(f, f), BackgroundColor3 = colorKey,
                BackgroundTransparency = strength or 0.955, BorderSizePixel = 0, Parent = orb,
            })
            corner(ring, 999)
        end
        return orb
    end
    orbA = makeOrb("Accent", 460)
    orbB = makeOrb("Accent2", 400)
    orbC = makeOrb("Accent", 300, 0.972)
    end

    local particles = {}
    for i = 1, 16 do
        local sz  = math.random(2, 4)
        local dot = new("Frame", {
            Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = (i % 2 == 0) and "Accent" or "Accent2",
            BackgroundTransparency = 0.7, BorderSizePixel = 0, Parent = fx,
        })
        corner(dot, 999)
        particles[i] = {
            dot = dot, x = math.random(), y = math.random(),
            speed = 0.012 + math.random() * 0.026, phase = math.random() * 6.28,
            sway = 0.01 + math.random() * 0.02,
        }
    end

    newT("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.945), NumberSequenceKeypoint.new(1, 1) }),
        Parent = newT("Frame", {
            Name = "TopSheen", Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = inner,
        }),
    })

    local borderGrad
    do
        local hairline = newT("Frame", {
            Name = "Hairline", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 9, Parent = main,
        })
        corner(hairline, RADIUS)
        newT("UIStroke", {
            Color = WHITE, Thickness = 1, Transparency = 0.88,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = hairline,
        })

        local border = newT("Frame", {
            Name = "Border", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 10, Parent = main,
        })
        corner(border, RADIUS)
        local borderStroke = newT("UIStroke", {
            Color = WHITE, Thickness = 1.5, Transparency = 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = border,
        })
        borderGrad = new("UIGradient", {
            Color = function(T)
                return ColorSequence.new({
                    ColorSequenceKeypoint.new(0, T.Accent),
                    ColorSequenceKeypoint.new(0.5, T.Accent2),
                    ColorSequenceKeypoint.new(1, T.Accent),
                })
            end,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(0.3, 0.94),
                NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(0.8, 0.94),
                NumberSequenceKeypoint.new(1, 0.45),
            }),
            Parent = borderStroke,
        })
    end

    local userScale = math.clamp((tonumber(opt("Scale", 100)) or 100) / 100, 0.8, 1.2)

    local function autoScale()
        local vp = getViewport()
        return math.clamp(math.min((vp.X - 16) / WINDOW_SIZE.X, (vp.Y - 16) / WINDOW_SIZE.Y), 0.4, 1)
    end

    local function effScale() return userScale * autoScale() end

    local function clampWindow()
        local vp = getViewport()
        local s  = effScale()
        local hw, hh = WINDOW_SIZE.X * s / 2, WINDOW_SIZE.Y * s / 2
        local m = 8
        local x, y = main.Position.X.Offset, main.Position.Y.Offset
        if hw + m > vp.X - hw - m then x = vp.X / 2 else x = math.clamp(x, hw + m, vp.X - hw - m) end
        if hh + m > vp.Y - hh - m then y = vp.Y / 2 else y = math.clamp(y, hh + m, vp.Y - hh - m) end
        main.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
    end

    local function applyScale(animate)
        Canvas.sync(effScale())
        if animate then
            tween(mainScale, 0.25, { Scale = effScale() })
        else
            mainScale.Scale = effScale()
        end
        clampWindow()
    end

    local topbar = new("Frame", {
        Name = "Topbar", Size = UDim2.new(1, 0, 0, TOP_H), BackgroundColor3 = "Top",
        BackgroundTransparency = 0.45, BorderSizePixel = 0, Active = true, Parent = inner,
    })

    new("Frame", {
        Name = "Divider", Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = WHITE, BackgroundTransparency = 0.92, BorderSizePixel = 0, Parent = topbar,
    })

    local trafficLights = newT("Frame", {
        Name = "TrafficLights", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 18, 0.5, 0),
        Size = UDim2.fromOffset(58, 14), BackgroundTransparency = 1, Parent = topbar,
    })

    local closeBtn, minimizeBtn, zoomBtn
    do
    local lightHover, lightSymbols = 0, {}

    local function setSymbols(on)
        for _, f in ipairs(lightSymbols) do tween(f, 0.12, { BackgroundTransparency = on and 0.1 or 1 }) end
    end

    local function makeLight(col, posX, kind)
        local wrapper = newT("Frame", {
            Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(posX, 0),
            BackgroundTransparency = 1, Parent = trafficLights,
        })
        local light = newT("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = wrapper,
        })
        corner(light, 999)
        newT("UIGradient", {
            Color = ColorSequence.new(col:Lerp(WHITE, 0.22), col:Lerp(BLACK, 0.06)), Rotation = 90, Parent = light,
        })
        newT("UIStroke", {
            Color = BLACK, Transparency = 0.72, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = light,
        })
        local glow = newT("UIStroke", {
            Color = col, Transparency = 0.55, Thickness = 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = light,
        })
        local lightScale = newT("UIScale", { Scale = 1, Parent = wrapper })

        local sym = rgb(70, 20, 15)
        if kind == "Close" then sym = rgb(95, 18, 12) elseif kind == "Minimize" then sym = rgb(105, 66, 0) else sym = rgb(10, 80, 20) end
        local function bar(rot, w, h)
            local f = newT("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(w, h or 1.6), Rotation = rot, BackgroundColor3 = sym,
                BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = light,
            })
            table.insert(lightSymbols, f)
        end
        if kind == "Close" then bar(45, 8); bar(-45, 8)
        elseif kind == "Minimize" then bar(0, 8)
        else bar(0, 8); bar(90, 8) end

        local hit = newT("TextButton", {
            Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, -4), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, ZIndex = 5, Parent = wrapper,
        })

        trackConn(hit.MouseEnter:Connect(function()
            lightHover = lightHover + 1
            setSymbols(true)
            tween(glow, 0.15, { Thickness = 3 })
        end))
        trackConn(hit.MouseLeave:Connect(function()
            lightHover = math.max(lightHover - 1, 0)
            if lightHover == 0 then setSymbols(false) end
            tween(glow, 0.2, { Thickness = 0 })
        end))
        trackConn(hit.MouseButton1Down:Connect(function() tween(lightScale, 0.08, { Scale = 0.86 }, Enum.EasingStyle.Quad) end))
        trackConn(hit.MouseButton1Up:Connect(function() tween(lightScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end))

        return wrapper, light, hit
    end

    closeBtn    = select(3, makeLight(TL.Red, 0, "Close"))
    minimizeBtn = select(3, makeLight(TL.Yellow, 22, "Minimize"))
    zoomBtn     = select(3, makeLight(TL.Green, 44, "Zoom"))
    end

    local titleGroup = newT("Frame", {
        Name = "TitleGroup", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(150, 36), BackgroundTransparency = 1, Parent = topbar,
    })

    accentGradient(textLabel({
        Name = "Title", Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
        Text = CONFIG.TITLE, Font = Enum.Font.GothamBlack, TextSize = 17, TextColor3 = WHITE, Parent = titleGroup,
    }), 0)

    local controls = newT("Frame", {
        Name = "Controls", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(0, 32), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1, Parent = topbar,
    })
    newT("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = controls,
    })

    local statDot, statLabel
    do
        local statChip = new("Frame", {
            Name = "Stats", Size = UDim2.fromOffset(122, 26), LayoutOrder = 1,
            BackgroundColor3 = "InputBg", BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = controls,
        })
        corner(statChip, 13)
        stroke(statChip, WHITE, 0.9, 1)
        statDot = newT("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(7, 7),
            BackgroundColor3 = Theme.Success, BorderSizePixel = 0, Parent = statChip,
        })
        corner(statDot, 999)
        statLabel = textLabel({
            Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -28, 1, 0), Text = "-- FPS · -- ms",
            Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = "SubText", Parent = statChip,
        })
    end

    local discordBtn = newT("TextButton", {
        Name = "Discord", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
        Size = UDim2.fromOffset(100, 30), LayoutOrder = 2, Parent = controls,
    })
    local discordLabel

    local discordTick, discordFlash
    do
        local BLURPLE = rgb(88, 101, 242)
        local hovered, flashToken = false, 0

        local dBg = newT("Frame", {
            Name = "Bg", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1, Parent = discordBtn,
        })
        corner(dBg, 15)
        newT("UIGradient", {
            Color = ColorSequence.new(rgb(126, 138, 255), rgb(76, 88, 232)), Rotation = 90, Parent = dBg,
        })
        local dStroke = newT("UIStroke", {
            Color = rgb(184, 191, 255), Transparency = 0.5, Thickness = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = dBg,
        })
        discordLabel = newT("TextLabel", {
            Name = "Label", BackgroundTransparency = 1, Position = UDim2.fromOffset(35, 0), Size = UDim2.new(1, -43, 1, 0),
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = WHITE, Text = CONFIG.FALLBACK_DISCORD,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = discordBtn,
        })

        local clip = newT("CanvasGroup", {
            Name = "Fx", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = discordBtn,
        })
        corner(clip, 15)
        local tint = newT("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(46, 196, 120), BackgroundTransparency = 1,
            BorderSizePixel = 0, ZIndex = 1, Parent = clip,
        })
        local gloss = newT("Frame", {
            Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2, Parent = clip,
        })
        newT("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1) }),
            Parent = gloss,
        })
        local shine = newT("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(-0.3, 0, 0.5, 0), Size = UDim2.new(0, 30, 2.2, 0),
            Rotation = 18, BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Visible = false, Parent = clip,
        })
        newT("UIGradient", {
            Rotation = 0,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.72), NumberSequenceKeypoint.new(1, 1),
            }),
            Parent = shine,
        })

        local icon = newT("Frame", {
            Name = "Icon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0),
            Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, ZIndex = 4, Parent = discordBtn,
        })
        if CONFIG.ICON_DISCORD ~= "" then
            newT("ImageLabel", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = CONFIG.ICON_DISCORD, ZIndex = 5, Parent = icon,
            })
        else
            local function part(w, h, x, y, rot, col, r)
                local f = newT("Frame", {
                    Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), Rotation = rot or 0,
                    BackgroundColor3 = col or WHITE, BorderSizePixel = 0, ZIndex = 5, Parent = icon,
                })
                corner(f, r or 2)
                return f
            end
            part(6, 6, 2.5, 3.5, -32, WHITE, 2)
            part(6, 6, 13.5, 3.5, 32, WHITE, 2)
            part(20, 14, 1, 5.5, 0, WHITE, 7)
            part(5, 5, 3.5, 15.5, 22, WHITE, 2)
            part(5, 5, 13.5, 15.5, -22, WHITE, 2)
            part(4, 5.5, 5.5, 9.5, 0, BLURPLE, 2)
            part(4, 5.5, 12.5, 9.5, 0, BLURPLE, 2)
        end

        local sc = newT("UIScale", { Scale = 1, Parent = discordBtn })

        local function wiggle()
            tween(icon, 0.08, { Rotation = -14 }, Enum.EasingStyle.Quad)
            task.delay(0.08, function() if icon.Parent then tween(icon, 0.12, { Rotation = 12 }) end end)
            task.delay(0.2, function()
                if icon.Parent then tween(icon, 0.28, { Rotation = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end
            end)
        end

        trackConn(discordBtn.MouseEnter:Connect(function()
            hovered = true
            tween(sc, 0.18, { Scale = 1.05 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(dStroke, 0.15, { Transparency = 0.1, Thickness = 1.5 })
            wiggle()
        end))
        trackConn(discordBtn.MouseLeave:Connect(function()
            hovered = false
            tween(sc, 0.22, { Scale = 1 })
            tween(dStroke, 0.2, { Thickness = 1 })
        end))
        trackConn(discordBtn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 0.94 }, Enum.EasingStyle.Quad) end))
        trackConn(discordBtn.MouseButton1Up:Connect(function() tween(sc, 0.25, { Scale = hovered and 1.06 or 1 }, Enum.EasingStyle.Back) end))

        discordFlash = function(ok)
            flashToken = flashToken + 1
            local mine = flashToken
            spawnRipple(discordBtn, 15)
            tint.BackgroundColor3 = ok and rgb(46, 196, 120) or rgb(235, 64, 84)
            tween(tint, 0.2, { BackgroundTransparency = 0.1 })
            discordLabel.Text = ok and "Copied!" or "No clipboard"
            task.delay(1.8, function()
                if flashToken == mine and discordBtn.Parent then
                    tween(tint, 0.35, { BackgroundTransparency = 1 })
                    discordLabel.Text = CONFIG.FALLBACK_DISCORD
                end
            end)
        end

        discordTick = function(t)
            local phase = (t * 0.4) % 3.2
            if phase < 1.3 then
                shine.Visible = true
                shine.Position = UDim2.new(-0.25 + (phase / 1.3) * 1.5, 0, 0.5, 0)
            else
                shine.Visible = false
            end
            if not hovered then
                dStroke.Transparency = 0.62 - 0.24 * (0.5 + 0.5 * math.sin(t * 2.2))
            end
        end
    end

    register("Buttons", "Close",    { Button = closeBtn,    Click = function(cb) return trackConn(closeBtn.MouseButton1Click:Connect(cb)) end })
    register("Buttons", "Minimize", { Button = minimizeBtn, Click = function(cb) return trackConn(minimizeBtn.MouseButton1Click:Connect(cb)) end })
    register("Buttons", "Zoom",     { Button = zoomBtn,     Click = function(cb) return trackConn(zoomBtn.MouseButton1Click:Connect(cb)) end })
    register("Buttons", "Discord",  { Button = discordBtn, Label = discordLabel, GetText = function() return discordLabel.Text end, SetText = function(t) discordLabel.Text = tostring(t) end, Click = function(cb) return trackConn(discordBtn.MouseButton1Click:Connect(cb)) end })

    trackConn(discordBtn.MouseButton1Click:Connect(function()
        local copier = setclipboard or toclipboard or (Clipboard and Clipboard.set)
        local ok = copier and pcall(copier, DISCORD_URL) and true or false
        discordFlash(ok)
        showToast(ok and "Discord link copied!" or "Clipboard not available", ok and "success" or "error")
    end))

    local miniFrame = new("Frame", {
        Name = "MiniFrame", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE,
        BorderSizePixel = 0, Size = UDim2.fromOffset(MINI_SIZE.X, MINI_SIZE.Y),
        Position = UDim2.fromOffset(math.floor(getViewport().X / 2), math.floor(getViewport().Y - 56)),
        Visible = false, Active = true, ZIndex = 30, Parent = gui,
    })
    corner(miniFrame, 22)
    do
